// TREASURE SCREEN
// ============================================================
function renderTreasure() {
  const screen = el('div', {className:'screen', style:{
    alignItems:'center', justifyContent:'center', background:'#0a0000',
    minHeight:'100vh'
  }});

  screen.appendChild(el('div', {className:'overlay', style:{
    background:'radial-gradient(ellipse at center, rgba(120,60,0,0.2) 0%, rgba(0,0,0,0.85) 70%, black 100%)'
  }}));
  screen.appendChild(makeParticles(30,'#f59e0b'));

  const content = el('div', {className:'content', style:{
    display:'flex', flexDirection:'column', alignItems:'center', gap:'2rem',
    padding:'2rem', textAlign:'center', animation:'fade-in-up 1s ease both'
  }});

  content.appendChild(el('p', {style:{
    fontFamily:'var(--font-mono)', fontSize:'0.7rem', letterSpacing:'0.3em',
    textTransform:'uppercase', color:'rgba(245,158,11,0.6)'
  }}, '— 4,000 METERS —'));

  content.appendChild(el('h2', {style:{
    fontFamily:'var(--font-display)', fontSize:'clamp(1.8rem,5vw,2.8rem)',
    fontWeight:'900', color:'rgba(255,255,255,0.85)',
    textShadow:'0 0 40px rgba(245,158,11,0.3)'
  }}, 'Something Is Down Here'));

  content.appendChild(el('p', {style:{
    fontFamily:'var(--font-body)', fontSize:'1.05rem', lineHeight:'1.7',
    color:'rgba(255,255,255,0.6)', maxWidth:'440px', fontStyle:'italic'
  }}, 'The lights catch it in the silt. It\'s been here longer than anything you\'ve got a word for. Could be nothing. Could be everything. You didn\'t come four thousand meters to turn back now.'));

  const chestCanvas = document.createElement('canvas');
  chestCanvas.width = 200; chestCanvas.height = 200;
  chestCanvas.style.cssText = 'cursor:pointer;filter:drop-shadow(0 0 20px rgba(245,158,11,0.4));transition:filter 0.3s;';

  let clicks = state.treasureClicks;
  let chestOpen = false;

  function drawChest(openAmount = 0) {
    const ctx = chestCanvas.getContext('2d');
    const W = 200, H = 200;
    ctx.clearRect(0, 0, W, H);
    const cx = W/2, cy = H/2 + 10;
    const chestW = 110, chestH = 70;

    const glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, 90);
    glow.addColorStop(0, `rgba(245,158,11,${0.1 + openAmount*0.3})`);
    glow.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = glow; ctx.fillRect(0,0,W,H);

    ctx.save();
    const bodyGrad = ctx.createLinearGradient(cx-chestW/2, cy, cx+chestW/2, cy+chestH);
    bodyGrad.addColorStop(0, '#8B4513');
    bodyGrad.addColorStop(0.5, '#6B3410');
    bodyGrad.addColorStop(1, '#4a2008');
    ctx.fillStyle = bodyGrad;
    ctx.beginPath();
    ctx.roundRect(cx-chestW/2, cy, chestW, chestH, [0,0,8,8]);
    ctx.fill();

    ctx.strokeStyle = '#B8860B'; ctx.lineWidth = 3;
    for (let i = 0; i < 3; i++) {
      const bx = cx - chestW/2 + (i+1) * chestW/4;
      ctx.beginPath(); ctx.moveTo(bx, cy); ctx.lineTo(bx, cy+chestH); ctx.stroke();
    }
    ctx.beginPath(); ctx.moveTo(cx-chestW/2, cy+chestH*0.5); ctx.lineTo(cx+chestW/2, cy+chestH*0.5); ctx.stroke();

    ctx.fillStyle = '#DAA520';
    ctx.beginPath(); ctx.arc(cx, cy+chestH*0.35, 10, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = '#B8860B';
    ctx.beginPath(); ctx.rect(cx-6, cy+chestH*0.35, 12, 12); ctx.fill();

    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(-openAmount * Math.PI * 0.55);
    ctx.translate(-cx, -cy);

    const lidGrad = ctx.createLinearGradient(cx-chestW/2, cy-chestH*0.45, cx+chestW/2, cy);
    lidGrad.addColorStop(0, '#A0522D');
    lidGrad.addColorStop(1, '#6B3410');
    ctx.fillStyle = lidGrad;
    ctx.beginPath();
    ctx.moveTo(cx-chestW/2, cy);
    ctx.lineTo(cx+chestW/2, cy);
    ctx.lineTo(cx+chestW/2, cy-chestH*0.45);
    ctx.bezierCurveTo(cx+chestW/2, cy-chestH*0.7, cx-chestW/2, cy-chestH*0.7, cx-chestW/2, cy-chestH*0.45);
    ctx.closePath();
    ctx.fill();
    ctx.strokeStyle = '#B8860B'; ctx.lineWidth = 2; ctx.stroke();

    ctx.fillStyle = '#DAA520';
    ctx.beginPath(); ctx.arc(cx-chestW/2+10, cy, 5, 0, Math.PI*2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx+chestW/2-10, cy, 5, 0, Math.PI*2); ctx.fill();
    ctx.restore();

    if (openAmount > 0.3) {
      const goldLight = ctx.createRadialGradient(cx, cy, 0, cx, cy, chestW*0.6);
      goldLight.addColorStop(0, `rgba(255,215,0,${openAmount*0.5})`);
      goldLight.addColorStop(0.5, `rgba(245,158,11,${openAmount*0.2})`);
      goldLight.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = goldLight;
      ctx.beginPath(); ctx.ellipse(cx, cy+5, chestW*0.45, chestH*0.35, 0, 0, Math.PI*2); ctx.fill();
    }
    ctx.restore();

    if (!chestOpen) {
      const msgs = ['Click to examine...', 'Click again...', 'Open it...'];
      const msg = msgs[Math.min(clicks, 2)];
      ctx.fillStyle = `rgba(245,158,11,${0.5+openAmount*0.3})`;
      ctx.font = '12px Share Tech Mono, monospace';
      ctx.textAlign = 'center';
      ctx.fillText(msg, cx, H - 15);

      for (let i = 0; i < 3; i++) {
        ctx.beginPath(); ctx.arc(cx-16+i*16, H-5, 3, 0, Math.PI*2);
        ctx.fillStyle = i < clicks ? '#f59e0b' : 'rgba(255,255,255,0.2)';
        ctx.fill();
      }
    }
  }

  let targetOpen = 0, currentOpen = 0;
  let animId;
  function animate() {
    currentOpen += (targetOpen - currentOpen) * 0.08;
    drawChest(currentOpen);
    animId = requestAnimationFrame(animate);
  }

  drawChest(0);
  setTimeout(animate, 100);
  registerCleanup(() => { if(animId) cancelAnimationFrame(animId); });

  chestCanvas.addEventListener('click', () => {
    if (chestOpen) return;
    clicks++;
    targetOpen = clicks / 3;
    chestCanvas.style.filter = `drop-shadow(0 0 ${20+clicks*20}px rgba(245,158,11,${0.4+clicks*0.2}))`;
    chestCanvas.style.animation = `treasure-shake 0.4s ease`;
    setTimeout(() => chestCanvas.style.animation = '', 400);

    if (clicks >= 3) {
      chestOpen = true;
      targetOpen = 1;
      setTimeout(() => {
        cancelAnimationFrame(animId);
        setState({ screen:'revelation', treasureClicks:3 });
      }, 1800);
    }
  });

  chestCanvas.addEventListener('mouseenter', () => {
    if (!chestOpen) chestCanvas.style.filter = 'drop-shadow(0 0 30px rgba(245,158,11,0.6))';
  });
  chestCanvas.addEventListener('mouseleave', () => {
    if (!chestOpen) chestCanvas.style.filter = `drop-shadow(0 0 ${20+clicks*15}px rgba(245,158,11,${0.4+clicks*0.15}))`;
  });

  chestCanvas.style.animation = 'treasure-pulse 2s ease-in-out infinite';

  content.appendChild(chestCanvas);
  screen.appendChild(content);
  return screen;
}

// ============================================================
// DESCENT ANIMATION — FIX: skip button, guard for undefined level
// ============================================================
function renderDescent() {
  const currentLevel = GAME_LEVELS[state.currentLevel];
  const nextLevelIdx = state.currentLevel + 1;
  const nextLevel = nextLevelIdx < GAME_LEVELS.length ? GAME_LEVELS[nextLevelIdx] : null;
  const depthStart = currentLevel?.depthEnd ?? 0;
  const depthEnd = nextLevel?.depthEnd ?? 8000;
  const fromColor = currentLevel?.glowColor ?? '#06b6d4';
  const toColor = nextLevel?.glowColor ?? fromColor;
  const fromBg = currentLevel?.bgColor ?? '#000';
  const toBg = nextLevel?.bgColor ?? '#000';

  const screen = el('div', {className:'screen', style:{overflow:'hidden',position:'relative',width:'100%',height:'100vh'}});

  const canvas = document.createElement('canvas');
  canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;';
  screen.appendChild(canvas);

  // FIX: Skip descent button
  const skipBtn = el('button', {className:'btn-skip', onClick() {
    finished = true;
    cancelAnimationFrame(rafId);
    setState({ screen:'level-intro', currentLevel: nextLevelIdx, currentChallenge:0 });
  }}, 'Skip ▶▶');
  screen.appendChild(skipBtn);

  const hud = el('div', {style:{
    position:'absolute',top:0,left:0,right:0,zIndex:20,
    display:'flex',alignItems:'center',justifyContent:'space-between',
    padding:'1.25rem 1.5rem',
    background:'linear-gradient(to bottom, rgba(0,0,0,0.7), transparent)',
    pointerEvents:'none'
  }});
  const depthNum = el('div',{style:{display:'flex',flexDirection:'column',gap:'2px'}});
  depthNum.appendChild(el('span',{style:{fontFamily:'var(--font-mono)',fontSize:'0.6rem',letterSpacing:'0.25em',color:'rgba(255,255,255,0.35)',textTransform:'uppercase'}},'depth'));
  const depthVal = el('span',{style:{fontFamily:'var(--font-mono)',fontSize:'1.6rem',fontWeight:'700',color:fromColor,textShadow:`0 0 20px ${fromColor}80`,transition:'color 2s'}},depthStart.toLocaleString()+'m');
  depthNum.appendChild(depthVal);

  const rightHud = el('div',{style:{display:'flex',flexDirection:'column',alignItems:'flex-end',gap:'2px'}});
  rightHud.appendChild(el('span',{style:{fontFamily:'var(--font-mono)',fontSize:'0.6rem',letterSpacing:'0.2em',color:'rgba(255,255,255,0.3)',textTransform:'uppercase'}},'entering'));
  const zoneName = el('span',{style:{fontFamily:'var(--font-display)',fontSize:'1rem',fontWeight:'700',color:'rgba(255,255,255,0)',transition:'color 1.5s',letterSpacing:'0.05em'}},nextLevel?.name??'The Deep');
  rightHud.appendChild(zoneName);
  hud.append(depthNum, rightHud);
  screen.appendChild(hud);

  const banner = el('div',{style:{
    position:'absolute',bottom:'5%',left:'50%',transform:'translateX(-50%)',
    zIndex:20,textAlign:'center',opacity:'0',transition:'opacity 1.2s',pointerEvents:'none'
  }});
  banner.appendChild(el('p',{style:{fontFamily:'var(--font-mono)',fontSize:'0.7rem',letterSpacing:'0.3em',textTransform:'uppercase',color:'rgba(255,255,255,0.35)',marginBottom:'6px'}},'Now entering'));
  banner.appendChild(el('p',{style:{fontFamily:'var(--font-display)',fontSize:'1.8rem',fontWeight:'700',color:'#fff',textShadow:`0 0 30px ${toColor}`,letterSpacing:'0.05em'}},nextLevel?.name??'The Depths'));
  if (nextLevel) banner.appendChild(el('p',{style:{fontFamily:'var(--font-body)',fontStyle:'italic',fontSize:'0.9rem',color:'rgba(255,255,255,0.45)',marginTop:'4px'}},nextLevel.subtitle));
  screen.appendChild(banner);

  let rafId;
  const totalDuration = 5500;
  const startTime = Date.now();
  const depthRange = depthEnd - depthStart;
  let arrived=false, finished=false;
  let scrollY=0, bobAngle=0;
  const WORLD_H = 5000;

  function hexRGB(h) {
    if (!h || h[0] !== '#') return [0,0,0];
    const hex = h.length === 4 ? h[1]+h[1]+h[2]+h[2]+h[3]+h[3] : h.slice(1);
    return [parseInt(hex.slice(0,2),16)||0, parseInt(hex.slice(2,4),16)||0, parseInt(hex.slice(4,6),16)||0];
  }
  function lerp(a,b,t) { return a+(b-a)*t; }
  function lerpColor(a,b,t) {
    const [r1,g1,b1]=hexRGB(a),[r2,g2,b2]=hexRGB(b);
    return `rgb(${Math.round(lerp(r1,r2,t))},${Math.round(lerp(g1,g2,t))},${Math.round(lerp(b1,b2,t))})`;
  }

  const activeCreatures = nextLevel || currentLevel;
  const creatures = Array.from({length:20},(_,i)=>({
    x:Math.random()*900, y:200+Math.random()*(WORLD_H-400),
    r:4+Math.random()*10, phase:Math.random()*Math.PI*2,
    speed:0.3+Math.random()*0.6, glow:Math.random()>0.3,
    emoji: activeCreatures.creatures[i % activeCreatures.creatures.length]?.emoji||'🐟'
  }));
  const bubbles = Array.from({length:60},()=>({
    x:Math.random()*900,y:Math.random()*WORLD_H,
    r:1+Math.random()*3,speed:0.4+Math.random()*0.8,
    wobble:Math.random()*Math.PI*2,opacity:0.15+Math.random()*0.45
  }));
  const rockSilhouettes = Array.from({length:18},()=>({
    x:Math.random()*900,y:100+Math.random()*(WORLD_H-200),
    w:50+Math.random()*140,h:25+Math.random()*70,seed:Math.random()
  }));
  const streaks = Array.from({length:25},()=>({
    x:Math.random()*900,len:25+Math.random()*70,opacity:0.02+Math.random()*0.06,speed:1+Math.random()*2
  }));

  function draw(ts) {
    const W=canvas.width=canvas.clientWidth||window.innerWidth;
    const H=canvas.height=canvas.clientHeight||window.innerHeight;
    const ctx=canvas.getContext('2d');
    const elapsed=Date.now()-startTime;
    const progress=Math.min(elapsed/totalDuration,1);
    const eased=1-Math.pow(1-progress,3);
    scrollY=eased*(WORLD_H-H*0.4); bobAngle+=0.02;
    const currentDepth=Math.floor(depthStart+depthRange*eased);
    const t=eased;

    const [gr,gg,gb]=hexRGB(fromColor),[tr2,tg2,tb2]=hexRGB(toColor);
    const cr=Math.round(lerp(gr,tr2,t)),cg=Math.round(lerp(gg,tg2,t)),cb=Math.round(lerp(gb,tb2,t));

    const bg=ctx.createLinearGradient(0,0,0,H);
    bg.addColorStop(0,lerpColor(fromBg,toBg,t));
    bg.addColorStop(1,lerpColor(fromBg,'#000000',t));
    ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

    for(let i=0;i<5;i++){
      const by=((i*H*0.25)-scrollY*0.04)%(H*1.2)-H*0.1;
      const hg=ctx.createLinearGradient(0,by,0,by+H*0.25);
      hg.addColorStop(0,'rgba(0,0,0,0)');
      hg.addColorStop(0.5,`rgba(0,0,0,${0.03+t*0.04})`);
      hg.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle=hg; ctx.fillRect(0,by,W,H*0.25);
    }

    streaks.forEach(s=>{
      const vy=(((s.x*7-scrollY*s.speed*1.6)%WORLD_H+WORLD_H)%WORLD_H)*(H/WORLD_H);
      ctx.strokeStyle=`rgba(${cr},${cg},${cb},${s.opacity})`;
      ctx.lineWidth=0.8; ctx.beginPath();
      ctx.moveTo(s.x/900*W,vy); ctx.lineTo(s.x/900*W,vy+s.len); ctx.stroke();
    });

    rockSilhouettes.forEach(rock=>{
      const wy=rock.y-scrollY*0.35;
      if(wy<-rock.h-30||wy>H+30) return;
      const sx=rock.x/900*W;
      ctx.beginPath();
      const pts=5+Math.floor(rock.seed*4);
      for(let i=0;i<=pts;i++){
        const px=sx-rock.w/2+(rock.w/pts)*i;
        const jag=(Math.sin(rock.seed*10+i*2.3)*0.4+0.5);
        const py=wy+rock.h-rock.h*jag*(i===0||i===pts?0.1:1);
        i===0?ctx.moveTo(px,wy+rock.h):ctx.lineTo(px,py);
      }
      ctx.lineTo(sx+rock.w/2,wy+rock.h); ctx.closePath();
      ctx.fillStyle=`rgba(${cr},${cg},${cb},${0.04+rock.seed*0.05})`; ctx.fill();
      ctx.strokeStyle=`rgba(${cr},${cg},${cb},${0.07+rock.seed*0.04})`; ctx.lineWidth=1; ctx.stroke();
    });

    creatures.forEach((c,i)=>{
      const wy=c.y-scrollY*0.75;
      if(wy<-40||wy>H+40) return;
      const cx2=c.x/900*W+Math.sin(c.phase+ts/1200*c.speed)*20;
      const cy2=wy+Math.cos(c.phase+ts/900*c.speed)*12;
      const pulse=0.5+0.5*Math.sin(ts/600+c.phase);
      if(c.glow){
        const grd=ctx.createRadialGradient(cx2,cy2,0,cx2,cy2,c.r*5);
        grd.addColorStop(0,`rgba(${cr},${cg},${cb},${0.25*pulse})`);
        grd.addColorStop(1,'rgba(0,0,0,0)');
        ctx.fillStyle=grd; ctx.beginPath(); ctx.arc(cx2,cy2,c.r*5,0,Math.PI*2); ctx.fill();
      }
      ctx.font=`${(c.r*1.8+8)*(0.85+0.15*pulse)}px serif`;
      ctx.globalAlpha=0.35+0.3*pulse;
      ctx.fillText(c.emoji,cx2-c.r,cy2+c.r*0.4);
      ctx.globalAlpha=1;
    });

    bubbles.forEach(b=>{
      const wy=((b.y-scrollY*1.3)%WORLD_H+WORLD_H)%WORLD_H;
      const sy=wy>H?wy-WORLD_H:wy;
      const bx=b.x/900*W+Math.sin(b.wobble+ts/800)*7;
      ctx.beginPath(); ctx.arc(bx,sy,b.r,0,Math.PI*2);
      ctx.strokeStyle=`rgba(${cr},${cg},${cb},${b.opacity*(0.5+0.5*Math.sin(ts/500+b.wobble))})`;
      ctx.lineWidth=0.8; ctx.stroke();
    });

    ctx.save();
    for(let rs=0;rs<2;rs++){
      const rx=rs===0?W*0.06:W*0.94;
      ctx.globalAlpha=0.08+t*0.06;
      ctx.strokeStyle=`rgb(${cr},${cg},${cb})`;
      ctx.lineWidth=3+state.currentLevel*0.8;
      ctx.beginPath(); ctx.moveTo(rx,0);
      for(let ry=0;ry<H;ry+=20){
        ctx.lineTo(rx+Math.sin(ry/80+ts/2000+rs*3)*(20+state.currentLevel*3),ry);
      }
      ctx.stroke();
    }
    ctx.restore();

    // Submarine
    const subX=W/2, subY=H*0.36+Math.sin(bobAngle)*5;
    const subW=Math.min(160,W*0.25), subH=subW*0.38;

    ctx.save(); ctx.translate(subX,subY);

    const outerGlow=ctx.createRadialGradient(0,0,subH*0.3,0,0,subW);
    outerGlow.addColorStop(0,`rgba(${cr},${cg},${cb},0.15)`);
    outerGlow.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=outerGlow; ctx.beginPath(); ctx.ellipse(0,0,subW,subH*1.5,0,0,Math.PI*2); ctx.fill();

    const coneGrad=ctx.createRadialGradient(0,subH*0.5,0,0,subH*0.5+subH*4,subH*4.5);
    coneGrad.addColorStop(0,`rgba(${cr},${cg},${cb},0.25)`);
    coneGrad.addColorStop(0.4,`rgba(${cr},${cg},${cb},0.08)`);
    coneGrad.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=coneGrad;
    ctx.beginPath();
    ctx.moveTo(-subW*0.12,subH*0.5); ctx.lineTo(-subW*0.65,subH*5); ctx.lineTo(subW*0.65,subH*5); ctx.lineTo(subW*0.12,subH*0.5);
    ctx.closePath(); ctx.fill();

    const frontLight=ctx.createRadialGradient(-subW*0.48,0,0,-subW*0.48,0,subH*2.2);
    frontLight.addColorStop(0,`rgba(${cr},${cg},${cb},0.35)`);
    frontLight.addColorStop(0.4,`rgba(${cr},${cg},${cb},0.1)`);
    frontLight.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=frontLight;
    ctx.beginPath();
    ctx.moveTo(-subW*0.44,-subH*0.2); ctx.lineTo(-subW*1.7,-subH*0.7); ctx.lineTo(-subW*1.7,subH*0.7); ctx.lineTo(-subW*0.44,subH*0.2);
    ctx.closePath(); ctx.fill();

    const hullGrad=ctx.createLinearGradient(0,-subH/2,0,subH/2);
    hullGrad.addColorStop(0,`rgba(${cr},${cg},${cb},0.25)`);
    hullGrad.addColorStop(0.3,'rgba(25,35,55,0.97)');
    hullGrad.addColorStop(0.7,'rgba(15,22,38,0.99)');
    hullGrad.addColorStop(1,'rgba(8,12,22,0.97)');
    ctx.fillStyle=hullGrad;
    ctx.beginPath(); ctx.ellipse(0,0,subW/2,subH/2,0,0,Math.PI*2); ctx.fill();

    const shineGrad=ctx.createLinearGradient(-subW*0.3,-subH*0.35,-subW*0.1,-subH*0.05);
    shineGrad.addColorStop(0,`rgba(${cr},${cg},${cb},0.18)`);
    shineGrad.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=shineGrad;
    ctx.beginPath(); ctx.ellipse(-subW*0.15,-subH*0.2,subW*0.25,subH*0.22,0,0,Math.PI*2); ctx.fill();

    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.8)`;
    ctx.lineWidth=1.8;
    ctx.beginPath(); ctx.ellipse(0,0,subW/2,subH/2,0,0,Math.PI*2); ctx.stroke();

    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.5)`;
    for(let rv=-3;rv<=3;rv++){
      const ra=rv*(Math.PI/4);
      const rvx=(subW/2-5)*Math.cos(ra), rvy=(subH/2-3)*Math.sin(ra);
      ctx.beginPath(); ctx.arc(rvx,rvy,1.5,0,Math.PI*2); ctx.fill();
    }

    const towerGrad=ctx.createLinearGradient(subW*0.06,-subH/2-subH*0.7,subW*0.26,-subH/2);
    towerGrad.addColorStop(0,`rgba(${cr},${cg},${cb},0.3)`);
    towerGrad.addColorStop(1,'rgba(15,22,38,0.97)');
    ctx.fillStyle=towerGrad;
    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.7)`; ctx.lineWidth=1.5;
    ctx.beginPath();
    ctx.roundRect(subW*0.06,-subH/2-subH*0.62,subW*0.2,subH*0.62,4);
    ctx.fill(); ctx.stroke();

    ctx.beginPath(); ctx.arc(subW*0.16,-subH/2-subH*0.35,subH*0.12,0,Math.PI*2);
    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.2)`; ctx.fill();
    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.6)`; ctx.lineWidth=1.2; ctx.stroke();
    const twGlow=ctx.createRadialGradient(subW*0.16,-subH/2-subH*0.35,0,subW*0.16,-subH/2-subH*0.35,subH*0.12);
    twGlow.addColorStop(0,`rgba(${cr},${cg},${cb},0.45)`);
    twGlow.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=twGlow; ctx.beginPath(); ctx.arc(subW*0.16,-subH/2-subH*0.35,subH*0.12,0,Math.PI*2); ctx.fill();

    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.55)`; ctx.lineWidth=2; ctx.lineCap='round';
    ctx.beginPath();
    ctx.moveTo(subW*0.14,-subH/2-subH*0.62);
    ctx.lineTo(subW*0.14,-subH/2-subH*0.9);
    ctx.lineTo(subW*0.25,-subH/2-subH*0.9);
    ctx.stroke();
    ctx.beginPath(); ctx.arc(subW*0.25,-subH/2-subH*0.9,3,0,Math.PI*2);
    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.8)`; ctx.fill();

    for(let a=0;a<3;a++){
      const ax=subW*0.1+a*subW*0.06, ay=-subH/2;
      ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.4)`; ctx.lineWidth=1;
      ctx.beginPath(); ctx.moveTo(ax,ay); ctx.lineTo(ax+Math.sin(a)*3,ay-subH*0.25); ctx.stroke();
      ctx.beginPath(); ctx.arc(ax+Math.sin(a)*3,ay-subH*0.25,1.5,0,Math.PI*2);
      ctx.fillStyle=`rgba(${cr},${cg},${cb},0.7)`; ctx.fill();
    }

    const pox=-subW*0.2, poy=0;
    ctx.beginPath(); ctx.arc(pox,poy,subH*0.2,0,Math.PI*2);
    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.12)`; ctx.fill();
    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.75)`; ctx.lineWidth=1.5; ctx.stroke();
    const pGlow=ctx.createRadialGradient(pox,poy,0,pox,poy,subH*0.2);
    pGlow.addColorStop(0,`rgba(${cr},${cg},${cb},0.55)`);
    pGlow.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=pGlow; ctx.beginPath(); ctx.arc(pox,poy,subH*0.2,0,Math.PI*2); ctx.fill();
    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.25)`; ctx.lineWidth=0.8;
    ctx.beginPath(); ctx.moveTo(pox-subH*0.18,poy); ctx.lineTo(pox+subH*0.18,poy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(pox,poy-subH*0.18); ctx.lineTo(pox,poy+subH*0.18); ctx.stroke();

    const po2x=-subW*0.05, po2y=-subH*0.15;
    ctx.beginPath(); ctx.arc(po2x,po2y,subH*0.1,0,Math.PI*2);
    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.08)`; ctx.fill();
    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.4)`; ctx.lineWidth=1; ctx.stroke();
    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.3)`;
    ctx.beginPath(); ctx.arc(po2x,po2y,subH*0.1,0,Math.PI*2); ctx.fill();

    ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.12)`; ctx.lineWidth=0.8; ctx.setLineDash([4,6]);
    ctx.beginPath(); ctx.ellipse(0,0,subW*0.32,subH*0.5,0,0,Math.PI*2); ctx.stroke();
    ctx.beginPath(); ctx.ellipse(0,0,subW*0.15,subH*0.5,0,0,Math.PI*2); ctx.stroke();
    ctx.setLineDash([]);

    const propX=subW*0.48, propRot=ts/180;
    ctx.save(); ctx.translate(propX,0);
    ctx.fillStyle='rgba(15,22,38,0.9)'; ctx.strokeStyle=`rgba(${cr},${cg},${cb},0.5)`; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(0,0,subH*0.22,0,Math.PI*2); ctx.fill(); ctx.stroke();
    for(let b=0;b<4;b++){
      const ba=propRot+b*Math.PI/2;
      ctx.save(); ctx.rotate(ba);
      const bladeGrad=ctx.createLinearGradient(0,0,0,subH*0.38);
      bladeGrad.addColorStop(0,`rgba(${cr},${cg},${cb},0.7)`);
      bladeGrad.addColorStop(1,`rgba(${cr},${cg},${cb},0.1)`);
      ctx.fillStyle=bladeGrad;
      ctx.beginPath();
      ctx.moveTo(-subH*0.06,0);
      ctx.bezierCurveTo(-subH*0.1,subH*0.18,subH*0.1,subH*0.35,subH*0.06,subH*0.38);
      ctx.bezierCurveTo(-subH*0.02,subH*0.3,subH*0.06,subH*0.15,subH*0.06,0);
      ctx.closePath(); ctx.fill();
      ctx.restore();
    }
    ctx.fillStyle=`rgba(${cr},${cg},${cb},0.8)`; ctx.beginPath(); ctx.arc(0,0,4,0,Math.PI*2); ctx.fill();
    ctx.restore();

    for(let ex=0;ex<6;ex++){
      const ebx=propX+8+ex*9+Math.sin(ts/250+ex*1.3)*5;
      const eby=Math.sin(ts/180+ex*1.8)*subH*0.28;
      const er=2.5-ex*0.3;
      if(er<=0) continue;
      ctx.beginPath(); ctx.arc(ebx,eby,er,0,Math.PI*2);
      ctx.fillStyle=`rgba(${cr},${cg},${cb},${0.45-ex*0.07})`; ctx.fill();
    }

    ctx.restore();

    const vig=ctx.createRadialGradient(W/2,H/2,H*0.22,W/2,H/2,H*0.85);
    vig.addColorStop(0,'rgba(0,0,0,0)');
    vig.addColorStop(1,'rgba(0,0,0,0.75)');
    ctx.fillStyle=vig; ctx.fillRect(0,0,W,H);

    ctx.save(); ctx.globalAlpha=0.04+t*0.04;
    for(let sl=0;sl<H;sl+=4){
      ctx.fillStyle='rgba(0,0,0,0.5)';
      ctx.fillRect(0,sl,W,2);
    }
    ctx.restore();

    depthVal.textContent=currentDepth.toLocaleString()+'m';
    depthVal.style.color=`rgba(${cr},${cg},${cb},1)`;
    depthVal.style.textShadow=`0 0 20px rgba(${cr},${cg},${cb},0.8)`;

    if(eased>0.72&&!arrived){
      arrived=true;
      zoneName.style.color=`rgba(${cr},${cg},${cb},1)`;
      banner.style.opacity='1';
    }

    if(!finished){ rafId=requestAnimationFrame(draw); }
    if(progress>=1&&!finished){
      finished=true; cancelAnimationFrame(rafId);
      const dTimeoutId = setTimeout(()=>{
        setState({ screen:'level-intro', currentLevel:nextLevelIdx, currentChallenge:0 });
      },1800);
      registerCleanup(() => clearTimeout(dTimeoutId));
    }
  }

  const firstRafId = requestAnimationFrame(draw);
  registerCleanup(() => {
    finished = true;
    cancelAnimationFrame(rafId);
    cancelAnimationFrame(firstRafId);
  });

  return screen;
}

