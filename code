<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Anchor of Möbius</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Mono:ital,wght@0,400;0,500;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --glow: #06b6d4;
  --font-display: 'Playfair Display', Georgia, serif;
  --font-body: 'Cormorant Garamond', Georgia, serif;
  --font-mono: 'DM Mono', monospace;
  --font-ui: 'DM Sans', sans-serif;
}

html, body {
  width: 100%; height: 100%;
  background: #000;
  color: #fff;
  font-family: var(--font-ui);
  overflow-x: hidden;
}

#app { width: 100%; min-height: 100vh; position: relative; }

@keyframes float-particle {
  0%, 100% { transform: translateY(0px) scale(1); opacity: 0.5; }
  50% { transform: translateY(-20px) scale(1.1); opacity: 1; }
}
@keyframes rise-particle {
  0% { transform: translateY(100vh); opacity: 0; }
  10% { opacity: 0.7; }
  90% { opacity: 0.7; }
  100% { transform: translateY(-20px); opacity: 0; }
}
@keyframes pulse-ring { 0%, 100% { opacity: 0.2; transform: scale(1); } 50% { opacity: 0; transform: scale(1.3); } }
@keyframes shimmer-anim { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
@keyframes fade-in-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
@keyframes sway { 0%, 100% { transform: rotate(-1.5deg) scaleX(0.98); } 50% { transform: rotate(1.5deg) scaleX(1.02); } }
@keyframes cloud-drift { 0% { transform: translateX(0); } 100% { transform: translateX(60px); } }
@keyframes root-pulse { 0%, 100% { opacity: 0.7; filter: brightness(1); } 50% { opacity: 1; filter: brightness(1.3); } }
@keyframes bubble-rise { 0% { transform: translateY(0) translateX(0); opacity: 0.7; } 100% { transform: translateY(-80px) translateX(10px); opacity: 0; } }
@keyframes nen-glow { 0%, 100% { box-shadow: 0 0 15px rgba(6,182,212,0.4), 0 0 30px rgba(6,182,212,0.2); } 50% { box-shadow: 0 0 25px rgba(6,182,212,0.7), 0 0 50px rgba(6,182,212,0.4), 0 0 80px rgba(6,182,212,0.2); } }
@keyframes scan { 0% { top: -5%; } 100% { top: 105%; } }
@keyframes treasure-pulse { 0%, 100% { transform: scale(1) translateY(0); filter: brightness(1); } 50% { transform: scale(1.04) translateY(-4px); filter: brightness(1.3); } }
@keyframes treasure-shake { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-6px) rotate(-2deg); } 40% { transform: translateX(6px) rotate(2deg); } 60% { transform: translateX(-4px) rotate(-1deg); } 80% { transform: translateX(4px) rotate(1deg); } }
@keyframes golden-burst { 0% { transform: scale(0); opacity: 1; } 100% { transform: scale(3); opacity: 0; } }
@keyframes particle-explode { 0% { transform: translate(0,0) scale(1); opacity: 1; } 100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; } }
@keyframes typewriter { from { width: 0; } to { width: 100%; } }
@keyframes wave-text { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes island-bob { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-8px); } }

.screen { position: relative; min-height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.overlay { position: absolute; inset: 0; }
.content { position: relative; z-index: 10; }

button {
  font-family: var(--font-ui);
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
  font-size: 1rem;
  transition: all 0.2s;
}
button:active { transform: scale(0.97); }
button:disabled { cursor: default; opacity: 0.5; }

input {
  font-family: var(--font-mono);
  background: rgba(0,0,0,0.4);
  border: 2px solid rgba(255,255,255,0.2);
  color: #fff;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  font-size: 1.1rem;
  text-align: center;
  outline: none;
  text-transform: uppercase;
  transition: border-color 0.2s, box-shadow 0.2s;
}
input:focus { border-color: var(--glow); box-shadow: 0 0 0 3px color-mix(in srgb, var(--glow) 20%, transparent); }

/* HUD */
.hud {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.75rem 1.5rem;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(12px);
  flex-shrink: 0;
}
.hud-label { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.35); font-family: var(--font-mono); }
.hud-value { font-family: var(--font-mono); font-size: 0.875rem; color: rgba(255,255,255,0.85); }

/* Nen gauge */
.nen-gauge {
  display: flex; align-items: center; gap: 8px;
}
.nen-bar-bg { height: 8px; width: 120px; background: rgba(0,0,0,0.6); border-radius: 99px; overflow: hidden; border: 1px solid rgba(6,182,212,0.2); }
.nen-bar { height: 100%; border-radius: 99px; transition: width 1s linear; background: linear-gradient(to right, #06b6d4, #22d3ee); box-shadow: 0 0 8px rgba(6,182,212,0.6); }

/* Challenge card */
.challenge-card {
  background: rgba(0,0,0,0.55);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 1.25rem;
  padding: 2rem;
  backdrop-filter: blur(16px);
  max-width: 680px;
  width: 100%;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}

/* Timer */
.timer-wrap { display: flex; align-items: center; gap: 0.75rem; }
.timer-bar-bg { height: 5px; width: 140px; background: rgba(0,0,0,0.6); border-radius: 99px; overflow: hidden; }
.timer-bar { height: 100%; border-radius: 99px; transition: width 1s linear, background-color 0.5s; }
.timer-text { font-family: var(--font-mono); font-weight: 700; font-size: 1rem; min-width: 3.5ch; }

/* Progress dots */
.dots { display: flex; align-items: center; gap: 6px; }
.dot { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid rgba(255,255,255,0.2); transition: all 0.3s; }

/* Memory match */
.memory-grid { display: grid; gap: 8px; justify-content: center; }
.memory-card { perspective: 600px; cursor: pointer; position: relative; }
.memory-card-inner {
  width: 100%; height: 100%;
  position: relative; transform-style: preserve-3d;
  transition: transform 0.4s cubic-bezier(.25,.8,.25,1);
  border-radius: 0.5rem;
}
.memory-card-inner.flipped { transform: rotateY(180deg); }
.memory-card-face {
  position: absolute; inset: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: 0.5rem; backface-visibility: hidden; border: 2px solid;
}
.memory-card-back { background: rgba(0,0,0,0.7); }
.memory-card-front { transform: rotateY(180deg); }

/* Simon */
.simon-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.simon-pad {
  width: 130px; height: 130px; border-radius: 1rem; border: 2px solid;
  font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
  transition: all 0.15s; display: flex; align-items: center; justify-content: center;
  flex-direction: column; gap: 4px;
}

/* Code breaker */
.cb-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.cb-peg {
  width: 38px; height: 38px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.15s;
  font-size: 0.65rem; font-weight: 700;
}
.cb-hint { display: flex; flex-wrap: wrap; gap: 3px; width: 44px; }
.cb-hint-dot { width: 10px; height: 10px; border-radius: 50%; }
.cb-color-btn {
  width: 44px; height: 44px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15);
  cursor: pointer; transition: all 0.15s;
  font-weight: 700; font-size: 0.7rem; display: flex; align-items: center; justify-content: center;
}
.cb-color-btn:hover { transform: scale(1.15); border-color: rgba(255,255,255,0.6); }
.cb-color-btn.used { opacity: 0.35; cursor: not-allowed; transform: none !important; }

/* Word scramble */
.scramble-letters { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
.scramble-letter {
  width: 48px; height: 52px;
  display: flex; align-items: center; justify-content: center;
  border-radius: 0.5rem; border: 2px solid;
  font-size: 1.3rem; font-weight: 700;
  font-family: var(--font-mono);
}

/* Reaction */
.reaction-arena {
  position: relative; width: 100%; height: 300px;
  background: rgba(0,0,0,0.35); border-radius: 0.75rem;
  border: 1px solid rgba(255,255,255,0.06); overflow: hidden; cursor: crosshair;
}
.reaction-target {
  position: absolute; width: 56px; height: 56px; border-radius: 50%;
  border: 2px solid; display: flex; align-items: center; justify-content: center;
  cursor: pointer; transform: translate(-50%, -50%);
  font-size: 1.3rem;
}
@keyframes target-spawn { from { transform: translate(-50%,-50%) scale(0); opacity: 0; } to { transform: translate(-50%,-50%) scale(1); opacity: 1; } }
@keyframes target-pulse { 0%, 100% { box-shadow: 0 0 12px var(--tglow); } 50% { box-shadow: 0 0 30px var(--tglow), 0 0 60px var(--tglow); } }

/* Success overlay */
.success-overlay {
  position: fixed; inset: 0; z-index: 999;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);
}
.success-box {
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  background: rgba(0,0,0,0.9);
  border: 1px solid; border-radius: 1.25rem;
  padding: 2.5rem 4rem; backdrop-filter: blur(16px);
  animation: fade-in-up 0.3s ease;
}

/* Particles */
.particles { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.particle { position: absolute; border-radius: 50%; }

/* Buttons */
.btn-primary {
  position: relative; overflow: hidden;
  border-radius: 99px; border: 1px solid;
  padding: 0.9rem 2.5rem;
  font-size: 1rem; font-weight: 600;
  color: #fff; letter-spacing: 0.05em;
  transition: all 0.3s;
}
.btn-primary .shimmer {
  position: absolute; inset: 0;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.12), transparent);
  transform: translateX(-100%);
}
.btn-primary:hover .shimmer { animation: shimmer-anim 0.7s forwards; }

/* Skip button — unobtrusive floating pill */
.btn-skip {
  position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 50;
  border-radius: 99px;
  border: 1px solid rgba(255,255,255,0.18);
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(10px);
  color: rgba(255,255,255,0.5);
  padding: 0.5rem 1.25rem;
  font-size: 0.75rem; font-weight: 600;
  letter-spacing: 0.12em; text-transform: uppercase;
  font-family: var(--font-mono);
  cursor: pointer; transition: all 0.2s;
}
.btn-skip:hover {
  border-color: rgba(255,255,255,0.45);
  color: rgba(255,255,255,0.9);
  background: rgba(0,0,0,0.75);
}

/* Scanlines */
.scanlines {
  position: absolute; inset: 0;
  background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.18) 2px, rgba(0,0,0,0.18) 4px);
  opacity: 0.3; pointer-events: none;
}

/* Choice buttons */
.choice-btn {
  max-width: 300px; display: flex; flex-direction: column; align-items: center; gap: 12px;
  border: 1px solid; border-radius: 1.25rem; padding: 1.75rem;
  text-align: center; backdrop-filter: blur(10px);
  transition: all 0.3s; cursor: pointer;
  background: transparent;
}

/* Treasure chest */
.treasure-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
  position: relative;
}
.treasure-chest {
  cursor: pointer;
  position: relative;
  display: flex; flex-direction: column; align-items: center;
  transition: all 0.3s;
}
.treasure-chest:hover { filter: brightness(1.15); }

/* Depth indicator */
.depth-indicator {
  position: fixed; right: 20px; top: 50%; transform: translateY(-50%);
  z-index: 30; display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.depth-track {
  width: 4px; height: 200px; background: rgba(255,255,255,0.06);
  border-radius: 99px; position: relative;
}
.depth-fill {
  position: absolute; bottom: 0; left: 0; width: 100%;
  border-radius: 99px; transition: height 0.5s;
}

/* Calamity effect */
.calamity-alert {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  background: linear-gradient(to bottom, rgba(185,28,28,0.8), transparent);
  padding: 0.75rem; text-align: center;
  font-family: var(--font-mono); font-size: 0.75rem;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: #fca5a5; animation: blink 1s ease-in-out 3;
}

@media (max-width: 600px) {
  .memory-card { width: 58px !important; height: 58px !important; }
  .simon-pad { width: 108px; height: 108px; }
  .timer-bar-bg { width: 90px; }
  .challenge-card { padding: 1.25rem; }
  .hud { padding: 0.6rem 0.75rem; }
  .btn-primary { padding: 0.75rem 1.75rem; }
  .btn-skip { bottom: 1rem; right: 1rem; }
}
</style>
</head>
