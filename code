// ============================================================
function renderChallenge() {
  const level = getLevel();
  const challenge = getChallenge();
  if (!level || !challenge) return renderStart();

  const screen = el('div', {className:'screen', style:{background:level.bgColor}});

  screen.appendChild(el('div', {className:'overlay', style:{
    background:`radial-gradient(ellipse at 50% 120%, ${level.glowColor}08 0%, rgba(0,0,0,0.85) 60%)`
  }}));

  const hud = el('div', {className:'hud'});

  const hudLeft = el('div', {style:{display:'flex',flexDirection:'column',gap:'2px'}});
  hudLeft.appendChild(el('span', {className:'hud-label'}, `${level.name}`));
  hudLeft.appendChild(el('span', {className:'hud-value', style:{color:level.glowColor}}, `▼ ${level.depthStart.toLocaleString()}–${level.depthEnd.toLocaleString()}m`));

  const timerEl = makeTimer(level.glowColor, () => {
    setState({ screen:'game-over', failedAttempts: state.failedAttempts + 1 });
  });

  const nenGauge = el('div', {className:'nen-gauge'});
  nenGauge.appendChild(el('span', {style:{fontSize:'0.6rem',letterSpacing:'0.15em',color:'rgba(6,182,212,0.5)',fontFamily:'var(--font-mono)'}},'NEN'));
  const nenBg = el('div', {className:'nen-bar-bg'});
  const nenBar = el('div', {className:'nen-bar', style:{width: state.nenLevel + '%'}});
  nenBg.appendChild(nenBar);
  const nenPct = el('span', {style:{fontFamily:'var(--font-mono)',fontSize:'0.8rem',color:'rgba(6,182,212,0.8)',minWidth:'3ch'}}, state.nenLevel + '%');
  nenGauge.append(nenBg, nenPct);

  const dotsWrap = el('div', {className:'dots'});
  level.challenges.forEach((_, i) => {
    const d = el('div', {className:'dot', style:{
      borderColor: i <= state.currentChallenge ? level.glowColor : 'rgba(255,255,255,0.15)',
      backgroundColor: i < state.currentChallenge ? level.glowColor : i === state.currentChallenge ? `${level.glowColor}45` : 'transparent',
      boxShadow: i < state.currentChallenge ? `0 0 6px ${level.glowColor}` : 'none'
    }});
    dotsWrap.appendChild(d);
  });

  hud.append(hudLeft, timerEl, nenGauge, dotsWrap);
  screen.appendChild(hud);

  const main = el('div', {className:'content', style:{
    flex:'1', display:'flex', flexDirection:'column', alignItems:'center',
    justifyContent:'center', padding:'1.5rem 1rem', gap:'1.25rem'
  }});

  const header = el('div', {style:{textAlign:'center',display:'flex',flexDirection:'column',gap:'0.4rem'}});
  header.appendChild(el('span', {style:{
    fontSize:'0.65rem', fontWeight:'700', letterSpacing:'0.25em', textTransform:'uppercase',
    color:level.glowColor, fontFamily:'var(--font-mono)'
  }}, `Challenge ${state.currentChallenge + 1} of ${level.challenges.length} — ${level.calamityName.toUpperCase()}`));
  header.appendChild(el('h3', {style:{
    fontFamily:'var(--font-display)', fontSize:'clamp(1.3rem,4vw,1.9rem)',
    fontWeight:'700', color:'#fff', letterSpacing:'0.03em'
  }}, challenge.title));
  header.appendChild(el('p', {style:{
    fontFamily:'var(--font-body)', fontSize:'0.95rem', lineHeight:'1.6',
    color:'rgba(255,255,255,0.6)', maxWidth:'420px', margin:'0 auto'
  }}, challenge.description));
  main.appendChild(header);

  const box = el('div', {className:'challenge-card', style:{borderColor:`${level.glowColor}18`}});

  const onComplete = () => {
    const newNen = Math.max(10, state.nenLevel - Math.floor(Math.random() * 8 + 5));
    showSuccessOverlay(level, challenge, () => {
      const nextChallenge = state.currentChallenge + 1;
      if (nextChallenge >= GAME_LEVELS[state.currentLevel].challenges.length) {
        const nextLevel = state.currentLevel + 1;
        if (nextLevel >= GAME_LEVELS.length) {
          setState({ screen:'treasure', nenLevel: newNen, completedLevels:[...state.completedLevels, state.currentLevel], treasureClicks:0 });
        } else {
          setState({ screen:'descent', completedLevels:[...state.completedLevels, state.currentLevel], currentChallenge:0, nenLevel: newNen });
        }
      } else {
        setState({ currentChallenge:nextChallenge, screen:'challenge', challengeKey: state.challengeKey+1, nenLevel: newNen });
      }
    });
  };

  buildChallengeContent(box, challenge, level.glowColor, onComplete);
  main.appendChild(box);
  screen.appendChild(main);
  return screen;
}

function showSuccessOverlay(level, challenge, callback) {
  const overlay = el('div', {className:'success-overlay'});
  const box = el('div', {className:'success-box', style:{borderColor:`${level.glowColor}50`, boxShadow:`0 0 80px ${level.glowColor}20`}});
  const icon = el('div', {style:{fontSize:'2rem', animation:'fade-in-up 0.3s ease'}}, '✦');
  const txt = el('div', {style:{fontFamily:'var(--font-display)', fontSize:'2rem', fontWeight:'900', color:level.glowColor, letterSpacing:'0.05em'}}, 'Resolved');
  const sub = el('p', {style:{color:'rgba(255,255,255,0.4)',fontSize:'0.875rem',fontFamily:'var(--font-mono)'}},
    state.currentChallenge + 1 < GAME_LEVELS[state.currentLevel].challenges.length ? 'Calamity suppressed. Continuing descent...' : 'Zone cleared. Descending deeper...');
  box.append(icon, txt, sub);
  overlay.appendChild(box);
  document.getElementById('app').appendChild(overlay);
  setTimeout(() => { overlay.remove(); callback(); }, 1400);
}

function buildChallengeContent(container, challenge, glowColor, onComplete) {
  switch(challenge.type) {
    case 'memory-match': buildMemoryMatch(container, challenge.params, glowColor, onComplete); break;
    case 'simon-pattern': buildSimon(container, challenge.params, glowColor, onComplete); break;
    case 'reaction-game': buildReaction(container, challenge.params, glowColor, onComplete); break;
    case 'word-scramble': buildWordScramble(container, challenge.params, glowColor, onComplete); break;
    case 'code-breaker': buildCodeBreaker(container, challenge.params, glowColor, onComplete); break;
  }
}

// ============================================================
// TIMER
// ============================================================
function makeTimer(glowColor, onTimeUp) {
  const wrap = el('div', {className:'timer-wrap'});
  const barBg = el('div', {className:'timer-bar-bg'});
  const bar = el('div', {className:'timer-bar', style:{width:'100%', backgroundColor:glowColor}});
  barBg.appendChild(bar);
  const text = el('span', {className:'timer-text', style:{color:'#fff'}}, '4:00');
  wrap.append(barBg, text);

  let timeLeft = TIMER_SECONDS;
  let done = false;

  const interval = setInterval(() => {
    timeLeft--;
    if (timeLeft <= 0 && !done) {
      done = true; clearInterval(interval); onTimeUp(); return;
    }
    const m = Math.floor(timeLeft / 60), s = timeLeft % 60;
    text.textContent = `${m}:${s.toString().padStart(2,'0')}`;
    const pct = timeLeft / TIMER_SECONDS;
    bar.style.width = (pct * 100) + '%';
    const isCrit = timeLeft <= 10, isLow = timeLeft <= 30;
    const c = isCrit ? '#ef4444' : isLow ? '#f59e0b' : glowColor;
    bar.style.backgroundColor = c;
    bar.style.boxShadow = `0 0 8px ${c}`;
    text.style.color = isCrit ? '#ef4444' : isLow ? '#f59e0b' : '#fff';
    text.style.animation = isCrit ? 'blink 0.5s ease-in-out infinite' : '';
  }, 1000);

  registerCleanup(() => { clearInterval(interval); done = true; });
  return wrap;
}

// ============================================================
// MEMORY MATCH
// ============================================================
function buildMemoryMatch(container, params, glowColor, onComplete) {
  const { pairs, creatures } = params;
  const picked = creatures.slice(0, pairs);
  let deck = [...picked, ...picked].map((label, i) => ({ id:i, label, flipped:false, matched:false }));
  for (let i = deck.length-1; i>0; i--) { const j=Math.floor(Math.random()*(i+1)); [deck[i],deck[j]]=[deck[j],deck[i]]; }

  let selected=[], matchedCount=0, moves=0, canClick=true, completed=false, memActive=true;
  registerCleanup(() => { memActive = false; completed = true; });

  const stats = el('div', {style:{display:'flex',gap:'2rem',fontSize:'0.875rem',color:'rgba(255,255,255,0.55)',marginBottom:'1rem',fontFamily:'var(--font-mono)'}});
  const matchedText = el('span', {}); matchedText.innerHTML = `MATCHED <strong style="color:${glowColor}">0</strong>/${pairs}`;
  const movesText = el('span', {}); movesText.innerHTML = `MOVES <strong style="color:#fff">0</strong>`;
  stats.append(matchedText, movesText);

  const cols = pairs <= 6 ? 4 : pairs <= 8 ? 4 : 5;
  const CARD_SIZE = pairs <= 8 ? 68 : 62;
  const grid = el('div', {className:'memory-grid', style:{gridTemplateColumns:`repeat(${cols},${CARD_SIZE}px)`}});

  const cardEls = deck.map((card) => {
    const cardEl = el('div', {className:'memory-card', style:{width:CARD_SIZE+'px',height:CARD_SIZE+'px'}});
    const inner = el('div', {className:'memory-card-inner'});

    const back = el('div', {className:'memory-card-face memory-card-back', style:{
      borderColor:`${glowColor}25`, color:glowColor, fontSize:'1.3rem',
      background:'rgba(0,0,0,0.7)'
    }}, '✦');

    const front = el('div', {className:'memory-card-face memory-card-front', style:{
      borderColor:`${glowColor}50`, backgroundColor:`${glowColor}12`
    }});
    front.appendChild(el('span', {style:{fontSize:'1.1rem'}}, CREATURE_ICONS[card.label] || '?'));
    front.appendChild(el('span', {style:{fontSize:'0.55rem',color:'rgba(255,255,255,0.8)',lineHeight:'1.2',textAlign:'center',padding:'0 3px',marginTop:'2px'}}, card.label));

    inner.append(back, front);
    cardEl.appendChild(inner);

    cardEl.addEventListener('click', () => {
      if (!canClick || selected.includes(card.id) || card.matched || card.flipped) return;
      card.flipped = true; inner.classList.add('flipped'); selected.push(card.id);

      if (selected.length === 2) {
        canClick = false; moves++;
        movesText.innerHTML = `MOVES <strong style="color:#fff">${moves}</strong>`;
        const [id1,id2] = selected;
        const c1=deck.find(c=>c.id===id1), c2=deck.find(c=>c.id===id2);
        if (c1.label===c2.label) {
          setTimeout(() => {
            if(!memActive) return;
            c1.matched=true; c2.matched=true;
            [c1,c2].forEach(cd=>{
              const f=cardEls[deck.indexOf(cd)].querySelector('.memory-card-front');
              if(f){f.style.borderColor='#22c55e';f.style.backgroundColor='rgba(34,197,94,0.15)';f.style.boxShadow='0 0 20px rgba(34,197,94,0.3)';}
            });
            matchedCount++;
            matchedText.innerHTML = `MATCHED <strong style="color:${glowColor}">${matchedCount}</strong>/${pairs}`;
            selected=[]; canClick=true;
            if(matchedCount>=pairs&&!completed){completed=true;setTimeout(onComplete,600);}
          },350);
        } else {
          setTimeout(()=>{
            if(!memActive) return;
            c1.flipped=false;c2.flipped=false;
            [c1,c2].forEach(cd=>{const inn=cardEls[deck.indexOf(cd)].querySelector('.memory-card-inner');if(inn)inn.classList.remove('flipped');});
            selected=[]; canClick=true;
          },900);
        }
      }
    });
    return cardEl;
  });

  cardEls.forEach(c=>grid.appendChild(c));
  container.append(stats, grid);
}

// ============================================================
// SIMON PATTERN
// ============================================================
function buildSimon(container, params, glowColor, onComplete) {
  const { startLength, maxLength } = params;
  let sequence=[], playerInput=[], phase='showing', round=1;
  const totalRounds = maxLength - startLength + 1;
  let completed=false;

  const statusEl = el('div', {style:{display:'flex',flexWrap:'wrap',gap:'1rem',fontSize:'0.8rem',color:'rgba(255,255,255,0.5)',marginBottom:'1rem',justifyContent:'center',alignItems:'center',fontFamily:'var(--font-mono)'}});
  const roundText = el('span', {}); roundText.innerHTML = `ROUND <strong style="color:${glowColor}">1</strong>/${totalRounds}`;
  const seqText = el('span', {}); seqText.innerHTML = `LENGTH <strong style="color:#fff">${startLength}</strong>`;
  const phaseText = el('span', {style:{animation:'blink 1s ease-in-out infinite',color:'#f59e0b'}}, 'WATCH...');
  statusEl.append(roundText, seqText, phaseText);

  const gridEl = el('div', {className:'simon-grid'});
  const padEls = SIMON_PADS.map((pad, idx) => {
    const p = el('button', {className:'simon-pad', style:{
      borderColor:`${pad.base}40`, backgroundColor:`${pad.base}12`, color:`${pad.base}80`,
      fontFamily:'var(--font-mono)'
    }});
    p.innerHTML = `<span style="font-size:1.4rem">${['▲','◀','▶','▼'][idx]}</span><span style="font-size:0.7rem">${pad.label}</span>`;
    p.addEventListener('click', ()=>handlePadClick(idx));
    return p;
  });
  padEls.forEach(p=>gridEl.appendChild(p));

  const progressDots = el('div', {style:{display:'flex',gap:'5px',justifyContent:'center',marginTop:'0.75rem',flexWrap:'wrap'}});

  function updateDots() {
    progressDots.innerHTML='';
    sequence.forEach((_,i)=>{
      progressDots.appendChild(el('div',{style:{
        width:'7px',height:'7px',borderRadius:'50%',
        backgroundColor: i<playerInput.length ? (playerInput[i]===sequence[i]?'#22c55e':'#ef4444') : 'rgba(255,255,255,0.18)',
        boxShadow: (i<playerInput.length&&playerInput[i]===sequence[i])?'0 0 5px #22c55e':'none',
        transition:'all 0.2s'
      }}));
    });
  }

  function flashPad(idx, dur) {
    const pad=SIMON_PADS[idx], p=padEls[idx];
    p.style.borderColor=pad.active; p.style.backgroundColor=`${pad.active}45`;
    p.style.boxShadow=`0 0 35px ${pad.active}70, inset 0 0 20px ${pad.active}20`;
    p.style.transform='scale(1.06)'; p.style.color=pad.active;
    setTimeout(()=>{ p.style.borderColor=`${pad.base}40`; p.style.backgroundColor=`${pad.base}12`; p.style.boxShadow='none'; p.style.transform='scale(1)'; p.style.color=`${pad.base}80`; }, dur);
  }

  function setPhase(ph) {
    phase=ph; phaseText.style.animation='';
    if(ph==='showing'){phaseText.textContent='WATCH...';phaseText.style.animation='blink 1s ease-in-out infinite';phaseText.style.color='#f59e0b';}
    else if(ph==='input'){phaseText.textContent='YOUR TURN';phaseText.style.color='#22c55e';}
    else if(ph==='fail'){phaseText.textContent='WRONG — WATCH AGAIN';phaseText.style.color='#ef4444';}
    else if(ph==='success'){phaseText.textContent='CORRECT';phaseText.style.color='#22c55e';}
    padEls.forEach(p=>p.disabled=phase!=='input');
  }

  let simonActive = true;
  registerCleanup(() => { simonActive = false; completed = true; });

  function playSequence(seq) {
    if(!simonActive) return;
    setPhase('showing'); playerInput=[]; updateDots();
    seq.forEach((pi,i)=>{ setTimeout(()=>{ if(simonActive) flashPad(pi,420); }, i*650); });
    setTimeout(()=>{ if(simonActive) setPhase('input'); }, seq.length*650+250);
  }

  function handlePadClick(padIdx) {
    if(!simonActive || phase!=='input') return;
    flashPad(padIdx,200);
    playerInput=[...playerInput,padIdx]; updateDots();
    const step=playerInput.length-1;
    if(playerInput[step]!==sequence[step]){setPhase('fail');setTimeout(()=>playSequence(sequence),1200);return;}
    if(playerInput.length===sequence.length){
      setPhase('success');
      const nextRound=round+1;
      if(nextRound>totalRounds){if(!completed){completed=true;setTimeout(onComplete,800);}return;}
      round=nextRound; roundText.innerHTML=`ROUND <strong style="color:${glowColor}">${round}</strong>/${totalRounds}`;
      setTimeout(()=>{
        const nextSeq=[...sequence,Math.floor(Math.random()*4)];
        sequence=nextSeq; seqText.innerHTML=`LENGTH <strong style="color:#fff">${nextSeq.length}</strong>`;
        playSequence(nextSeq);
      },1100);
    }
  }

  const init=[];
  for(let i=0;i<startLength;i++) init.push(Math.floor(Math.random()*4));
  sequence=init; padEls.forEach(p=>p.disabled=true);
  setTimeout(()=>{ if(simonActive) playSequence(init); },900); updateDots();
  container.append(statusEl, gridEl, progressDots);
}

// ============================================================
// REACTION GAME — FIX: explicit failure feedback when misses exceeded
// ============================================================
function buildReaction(container, params, glowColor, onComplete) {
  const { targetCount, spawnInterval, lifetime } = params;
  let score=0, missed=0, spawned=0, completed=false;
  const maxMisses = Math.floor(targetCount * 0.4);
  let spawnId=null;

  const statusEl = el('div', {style:{display:'flex',gap:'2rem',fontSize:'0.8rem',color:'rgba(255,255,255,0.55)',marginBottom:'0.75rem',fontFamily:'var(--font-mono)'}});
  const scoreText=el('span',{}); scoreText.innerHTML=`HIT <strong style="color:${glowColor}">0</strong>/${targetCount}`;
  const missText=el('span',{}); missText.innerHTML=`MISSED <strong style="color:#ef4444">0</strong>/${maxMisses}`;
  statusEl.append(scoreText, missText);

  const arena = el('div', {className:'reaction-arena'});

  const startBtn = el('button', {style:{
    position:'absolute',top:'50%',left:'50%',transform:'translate(-50%,-50%)',
    borderRadius:'99px',border:`2px solid ${glowColor}60`,backgroundColor:`${glowColor}18`,
    color:'#fff',padding:'0.75rem 2rem',fontWeight:'700',fontSize:'1rem',
    cursor:'pointer',zIndex:'10',fontFamily:'var(--font-display)',letterSpacing:'0.1em'
  }});
  startBtn.textContent = '▶ ACTIVATE';
  startBtn.addEventListener('click', ()=>{ startBtn.remove(); startGame(); });
  arena.appendChild(startBtn);

  function checkMissFail() {
    if (missed >= maxMisses && !completed) {
      completed = true;
      clearInterval(spawnId);
      // Remove all remaining targets
      arena.querySelectorAll('.reaction-target').forEach(t => t.remove());
      // Show hull breach overlay
      const failMsg = el('div', {style:{
        position:'absolute',inset:'0',display:'flex',flexDirection:'column',
        alignItems:'center',justifyContent:'center',gap:'8px',
        background:'rgba(0,0,0,0.75)',borderRadius:'0.75rem',zIndex:'20'
      }});
      failMsg.appendChild(el('span',{style:{fontSize:'1.6rem'}},'💥'));
      failMsg.appendChild(el('p',{style:{
        fontFamily:'var(--font-mono)',fontSize:'0.85rem',color:'#ef4444',
        letterSpacing:'0.1em',textTransform:'uppercase'
      }},'HULL INTEGRITY LOST'));
      failMsg.appendChild(el('p',{style:{
        fontFamily:'var(--font-mono)',fontSize:'0.7rem',color:'rgba(255,255,255,0.35)'
      }},`${missed} contacts undefended`));
      arena.appendChild(failMsg);
      // Still count as complete so the timer handles the game-over, just show feedback
      // Actually mark complete and call onComplete after a beat so player sees it
      setTimeout(() => { onComplete(); }, 1800);
    }
  }

  function startGame() {
    spawnId = setInterval(()=>{
      if(spawned >= targetCount + maxMisses){
        clearInterval(spawnId);
        setTimeout(()=>{
          if(!completed){
            completed=true;
            if(score>=targetCount){ onComplete(); }
          }
        }, lifetime + 500);
        return;
      }
      spawnTarget(); spawned++;
    }, spawnInterval);
    registerCleanup(()=>{ clearInterval(spawnId); completed=true; });
  }

  const EMOJIS_BY_LEVEL = ['⚡','☠️','🔴','💥','⚠️','🩸','👁️'];
  function spawnTarget() {
    const size=56;
    const aW=arena.offsetWidth||600, aH=arena.offsetHeight||300;
    const x=size/2+Math.random()*(aW-size), y=size/2+Math.random()*(aH-size);
    const emoji = EMOJIS_BY_LEVEL[state.currentLevel % EMOJIS_BY_LEVEL.length];

    const t = el('div', {className:'reaction-target', style:{
      left:x+'px',top:y+'px',
      borderColor:`${glowColor}80`, backgroundColor:`${glowColor}15`,
      '--tglow':glowColor,
      animation:'target-spawn 0.2s ease, target-pulse 0.8s ease-in-out infinite 0.2s'
    }}, emoji);

    const ring = document.createElementNS('http://www.w3.org/2000/svg','svg');
    ring.style.cssText='position:absolute;inset:-8px;width:calc(100%+16px);height:calc(100%+16px);pointer-events:none;';
    ring.setAttribute('viewBox','0 0 72 72');
    const circle = document.createElementNS('http://www.w3.org/2000/svg','circle');
    circle.setAttribute('cx','36'); circle.setAttribute('cy','36'); circle.setAttribute('r','34');
    circle.setAttribute('fill','none'); circle.setAttribute('stroke',glowColor); circle.setAttribute('stroke-width','1.5');
    circle.setAttribute('stroke-dasharray','213'); circle.setAttribute('stroke-dashoffset','0');
    circle.style.transition=`stroke-dashoffset ${lifetime}ms linear`;
    ring.appendChild(circle); t.appendChild(ring);
    setTimeout(()=>{ circle.style.strokeDashoffset='213'; }, 50);

    t.addEventListener('click', e=>{
      e.stopPropagation(); t.remove();
      score++; scoreText.innerHTML=`HIT <strong style="color:${glowColor}">${score}</strong>/${targetCount}`;
      const pop = el('div', {style:{
        position:'absolute',left:x+'px',top:(y-20)+'px',
        color:glowColor,fontFamily:'var(--font-mono)',fontSize:'0.8rem',fontWeight:'700',
        pointerEvents:'none',animation:'fade-in-up 0.6s ease forwards',zIndex:'20'
      }},'+1');
      arena.appendChild(pop); setTimeout(()=>pop.remove(),600);
      if(score>=targetCount&&!completed){completed=true;clearInterval(spawnId);setTimeout(onComplete,500);}
    });

    arena.appendChild(t);
    setTimeout(()=>{
      if(t.parentNode===arena){
        t.remove();
        missed++;
        missText.innerHTML=`MISSED <strong style="color:#ef4444">${missed}</strong>/${maxMisses}`;
        checkMissFail();
      }
    }, lifetime);
  }

  container.append(statusEl, arena);
}

// ============================================================
// WORD SCRAMBLE
// ============================================================
function buildWordScramble(container, params, glowColor, onComplete) {
  const { words } = params;
  let currentIdx=0, solvedCount=0, completed=false, wsActive=true;
  registerCleanup(() => { wsActive = false; completed = true; });

  const wrap = el('div', {style:{display:'flex',flexDirection:'column',alignItems:'center',gap:'1.25rem'}});

  const progressWrap = el('div', {style:{display:'flex',flexDirection:'column',alignItems:'center',gap:'0.5rem',width:'100%'}});
  const solvedText = el('span', {style:{fontSize:'0.8rem',color:'rgba(255,255,255,0.5)',fontFamily:'var(--font-mono)'}});
  solvedText.innerHTML=`DECODED <strong style="color:${glowColor}">0</strong>/${words.length}`;
  const segRow = el('div', {style:{display:'flex',gap:'6px'}});
  const segs = words.map(()=>{
    const s=el('div',{style:{height:'4px',width:'50px',borderRadius:'99px',backgroundColor:'rgba(255,255,255,0.1)',transition:'all 0.3s'}});
    segRow.appendChild(s); return s;
  });
  progressWrap.append(solvedText, segRow);

  const scrambleRow = el('div', {className:'scramble-letters'});
  const hintEl = el('p', {style:{fontSize:'0.875rem',color:'rgba(251,191,36,0.9)',fontStyle:'italic',minHeight:'1.3em',fontFamily:'var(--font-body)'}});
  const hintBtn = el('button', {style:{fontSize:'0.8rem',color:'rgba(255,255,255,0.3)',transition:'color 0.2s',fontFamily:'var(--font-mono)'}}, '[ HINT ]');
  hintBtn.addEventListener('mouseenter',()=>hintBtn.style.color='rgba(255,255,255,0.6)');
  hintBtn.addEventListener('mouseleave',()=>hintBtn.style.color='rgba(255,255,255,0.3)');
  hintBtn.addEventListener('click',()=>{ hintEl.textContent='Hint: '+words[currentIdx].hint; hintBtn.style.display='none'; });

  const inputEl = el('input', {type:'text', placeholder:'TYPE ANSWER', style:{width:'220px',letterSpacing:'0.2em'}});
  const submitBtn = el('button', {style:{
    borderRadius:'0.5rem',border:`1px solid ${glowColor}50`,
    backgroundColor:`${glowColor}18`,color:'#fff',
    padding:'0.75rem 1.5rem',fontWeight:'700',fontFamily:'var(--font-mono)',fontSize:'0.85rem'
  }}, 'SUBMIT');
  submitBtn.addEventListener('mouseenter',()=>submitBtn.style.backgroundColor=`${glowColor}35`);
  submitBtn.addEventListener('mouseleave',()=>submitBtn.style.backgroundColor=`${glowColor}18`);

  const feedbackEl = el('p', {style:{fontWeight:'700',minHeight:'1.2em',fontSize:'0.9rem',fontFamily:'var(--font-mono)'}});

  function renderWord() {
    if(currentIdx>=words.length) return;
    const word=words[currentIdx];
    scrambleRow.innerHTML='';
    word.scrambled.split('').forEach((letter,i)=>{
      scrambleRow.appendChild(el('div',{className:'scramble-letter',style:{
        borderColor:`${glowColor}40`,backgroundColor:`${glowColor}10`,color:glowColor,
        animation:`float-particle ${1.5+i*0.25}s ease-in-out infinite`
      }},letter));
    });
    hintEl.textContent=''; hintBtn.style.display='';
    inputEl.value=''; inputEl.focus();
  }

  function submit() {
    if(currentIdx>=words.length) return;
    const guess = inputEl.value.trim().toUpperCase();
    if(guess===words[currentIdx].answer) {
      feedbackEl.textContent='✓ DECODED'; feedbackEl.style.color='#22c55e';
      inputEl.style.borderColor='#22c55e'; inputEl.style.boxShadow='0 0 20px rgba(34,197,94,0.3)';
      solvedCount++;
      solvedText.innerHTML=`DECODED <strong style="color:${glowColor}">${solvedCount}</strong>/${words.length}`;
      segs[currentIdx].style.backgroundColor=glowColor; segs[currentIdx].style.boxShadow=`0 0 8px ${glowColor}60`;
      setTimeout(()=>{
        if(!wsActive) return;
        feedbackEl.textContent=''; inputEl.style.borderColor=''; inputEl.style.boxShadow='';
        currentIdx++;
        if(currentIdx>=words.length&&!completed){completed=true;setTimeout(onComplete,300);}
        else renderWord();
      },700);
    } else {
      feedbackEl.textContent='✗ INVALID'; feedbackEl.style.color='#ef4444';
      inputEl.style.borderColor='#ef4444'; inputEl.style.boxShadow='0 0 20px rgba(239,68,68,0.3)';
      setTimeout(()=>{ feedbackEl.textContent=''; inputEl.style.borderColor=''; inputEl.style.boxShadow=''; },700);
    }
  }

  submitBtn.addEventListener('click',submit);
  inputEl.addEventListener('keydown',e=>{if(e.key==='Enter')submit();});
  inputEl.addEventListener('input',()=>inputEl.value=inputEl.value.toUpperCase());

  const inputRow=el('div',{style:{display:'flex',gap:'0.75rem',alignItems:'center'}});
  inputRow.append(inputEl,submitBtn);

  wrap.append(progressWrap, scrambleRow, hintEl, hintBtn, inputRow, feedbackEl);
  container.appendChild(wrap);
  renderWord();
}

// ============================================================
// CODE BREAKER — FIX: legend and status text respect allowRepeats param
// ============================================================
function buildCodeBreaker(container, params, glowColor, onComplete) {
  const { codeLength, maxAttempts, colors } = params;
  const allowRepeats = params.allowRepeats === true;

  let secret;
  if (allowRepeats) {
    secret = Array.from({length: codeLength}, () => colors[Math.floor(Math.random()*colors.length)]);
  } else {
    const shuffled = [...colors].sort(()=>Math.random()-0.5);
    secret = shuffled.slice(0, codeLength);
  }

  let currentGuess=[], guesses=[], won=false, completed=false, cbActive=true;
  let usedColorsInGuess = new Set();
  registerCleanup(() => { cbActive = false; completed = true; won = true; });

  const wrap = el('div', {style:{display:'flex',flexDirection:'column',gap:'0.75rem'}});

  const statusEl = el('div', {style:{fontSize:'0.8rem',color:'rgba(255,255,255,0.5)',display:'flex',gap:'1.5rem',justifyContent:'center',fontFamily:'var(--font-mono)'}});
  const attemptsText=el('span',{}); attemptsText.innerHTML=`ATTEMPTS <strong style="color:#fff">0</strong>/${maxAttempts}`;
  // FIX: Show correct rule based on allowRepeats
  const ruleText=el('span',{style:{color:glowColor,fontSize:'0.75rem'}});
  ruleText.textContent = allowRepeats ? '🔁 Colors may repeat' : '★ Each color used once';
  statusEl.append(attemptsText, ruleText);

  const historyEl = el('div', {style:{display:'flex',flexDirection:'column',gap:'5px',maxHeight:'220px',overflowY:'auto',paddingRight:'4px'}});

  const currentRow = el('div', {className:'cb-row', style:{justifyContent:'center',marginTop:'0.5rem'}});
  const currentPegs = Array.from({length:codeLength},()=>{
    const p=el('div',{className:'cb-peg',style:{backgroundColor:'rgba(255,255,255,0.06)',borderColor:'rgba(255,255,255,0.15)',cursor:'default'}});
    return p;
  });
  currentPegs.forEach(p=>currentRow.appendChild(p));

  const colorRow = el('div', {style:{display:'flex',gap:'7px',flexWrap:'wrap',justifyContent:'center',marginTop:'0.25rem'}});
  const colorBtns = {};
  colors.forEach(c=>{
    const btn=el('button',{className:'cb-color-btn',style:{backgroundColor:COLOR_MAP[c].bg},title:COLOR_MAP[c].label},c);
    btn.addEventListener('click',()=>{
      if(currentGuess.length<codeLength&&!won&&(allowRepeats||!usedColorsInGuess.has(c))){
        currentGuess.push(c); usedColorsInGuess.add(c);
        if (!allowRepeats) btn.classList.add('used');
        updateCurrentRow();
      }
    });
    colorBtns[c]=btn; colorRow.appendChild(btn);
  });

  const actionsRow = el('div', {style:{display:'flex',gap:'8px',justifyContent:'center',marginTop:'0.25rem'}});
  const backBtn = el('button', {style:{
    borderRadius:'0.5rem',border:'1px solid rgba(255,255,255,0.15)',
    backgroundColor:'rgba(255,255,255,0.06)',color:'rgba(255,255,255,0.65)',
    padding:'0.5rem 1rem',fontWeight:'600',fontSize:'0.85rem',fontFamily:'var(--font-mono)'
  }}, '⌫ UNDO');
  backBtn.addEventListener('click',()=>{
    if(currentGuess.length>0&&!won){
      const removed=currentGuess.pop();
      usedColorsInGuess.delete(removed);
      if (!allowRepeats) colorBtns[removed].classList.remove('used');
      updateCurrentRow();
    }
  });
  const submitBtn = el('button', {style:{
    borderRadius:'0.5rem',border:`1px solid ${glowColor}50`,
    backgroundColor:`${glowColor}18`,color:'#fff',
    padding:'0.5rem 1.25rem',fontWeight:'700',fontSize:'0.85rem',fontFamily:'var(--font-mono)'
  }}, 'SUBMIT');
  submitBtn.addEventListener('click',submitGuess);
  actionsRow.append(backBtn, submitBtn);

  // FIX: Legend shows correct rule
  const legend = el('div', {style:{display:'flex',gap:'12px',justifyContent:'center',fontSize:'0.7rem',color:'rgba(255,255,255,0.35)',fontFamily:'var(--font-mono)',flexWrap:'wrap'}});
  const lg1=el('span',{}); lg1.innerHTML='<span style="color:#22c55e">●</span> Right spot';
  const lg2=el('span',{}); lg2.innerHTML='<span style="color:#f59e0b">●</span> Wrong spot';
  const lg3=el('span',{style:{color: allowRepeats ? 'rgba(6,182,212,0.7)' : 'rgba(255,255,255,0.35)'}});
  lg3.textContent = allowRepeats ? '🔁 Colors repeat' : '🚫 All unique';
  legend.append(lg1,lg2,lg3);

  const feedbackEl=el('p',{style:{textAlign:'center',fontWeight:'700',minHeight:'1.2em',fontSize:'0.85rem',fontFamily:'var(--font-mono)'}});

  function updateCurrentRow() {
    currentPegs.forEach((p,i)=>{
      if(i<currentGuess.length){
        p.style.backgroundColor=COLOR_MAP[currentGuess[i]].bg;
        p.style.borderColor=COLOR_MAP[currentGuess[i]].bg;
        p.textContent=currentGuess[i];
        p.style.boxShadow=`0 0 8px ${COLOR_MAP[currentGuess[i]].bg}60`;
      } else {
        p.style.backgroundColor='rgba(255,255,255,0.06)';
        p.style.borderColor='rgba(255,255,255,0.15)';
        p.textContent=''; p.style.boxShadow='none';
      }
    });
  }

  function submitGuess() {
    if(!cbActive || currentGuess.length!==codeLength||won) return;
    const guess=[...currentGuess];
    let exact=0, close=0;
    const sCopy=[...secret], gCopy=[...guess];
    for(let i=0;i<codeLength;i++){
      if(gCopy[i]===sCopy[i]){exact++;sCopy[i]=null;gCopy[i]=null;}
    }
    for(let i=0;i<codeLength;i++){
      if(gCopy[i]===null) continue;
      const idx=sCopy.indexOf(gCopy[i]);
      if(idx!==-1){close++;sCopy[idx]=null;}
    }

    guesses.push({code:guess,exact,close});
    attemptsText.innerHTML=`ATTEMPTS <strong style="color:#fff">${guesses.length}</strong>/${maxAttempts}`;

    const row=el('div',{className:'cb-row',style:{justifyContent:'center',opacity:'0',transition:'opacity 0.3s'}});
    guess.forEach(c=>{
      row.appendChild(el('div',{className:'cb-peg',style:{
        backgroundColor:COLOR_MAP[c].bg,borderColor:COLOR_MAP[c].bg,cursor:'default',
        fontSize:'0.6rem',boxShadow:`0 0 5px ${COLOR_MAP[c].bg}50`
      }},c));
    });
    const hintBox=el('div',{className:'cb-hint'});
    for(let i=0;i<exact;i++) hintBox.appendChild(el('div',{className:'cb-hint-dot',style:{backgroundColor:'#22c55e',boxShadow:'0 0 5px #22c55e'}}));
    for(let i=0;i<close;i++) hintBox.appendChild(el('div',{className:'cb-hint-dot',style:{backgroundColor:'#f59e0b'}}));
    for(let i=0;i<codeLength-exact-close;i++) hintBox.appendChild(el('div',{className:'cb-hint-dot',style:{backgroundColor:'rgba(255,255,255,0.12)'}}));
    row.appendChild(hintBox);
    historyEl.appendChild(row);
    setTimeout(()=>{row.style.opacity='1';},40);
    historyEl.scrollTop=historyEl.scrollHeight;

    currentGuess=[]; usedColorsInGuess.clear();
    if (!allowRepeats) colors.forEach(c=>colorBtns[c].classList.remove('used'));
    updateCurrentRow();

    if(exact===codeLength){
      won=true; feedbackEl.textContent='✓ SEQUENCE UNLOCKED'; feedbackEl.style.color='#22c55e';
      if(!completed){completed=true;setTimeout(onComplete,1200);}
    } else if(guesses.length>=maxAttempts){
      feedbackEl.innerHTML=`<span style="color:#ef4444">FAILED — Code was: ${secret.join(' ')}</span>`;
      won=true;
      setTimeout(()=>{ if(!completed && cbActive){ completed=true; onComplete(); } }, 2500);
    } else {
      const rem=maxAttempts-guesses.length;
      feedbackEl.innerHTML=`<span style="color:rgba(255,255,255,0.45)">${exact} correct · ${close} wrong spot · ${rem} attempt${rem===1?'':'s'} left</span>`;
    }
  }

  wrap.append(statusEl, historyEl, currentRow, colorRow, actionsRow, legend, feedbackEl);
  container.appendChild(wrap);
}

