  startBtn.appendChild(el('div', {className:'shimmer'}));
  startBtn.addEventListener('mouseenter', () => { startBtn.style.backgroundColor = 'rgba(6,182,212,0.3)'; });
  startBtn.addEventListener('mouseleave', () => { startBtn.style.backgroundColor = 'rgba(6,182,212,0.15)'; });

  infoCard.append(desc, statsRow, startBtn);
  content.append(badge, titleWrap, spacer, infoCard);
  screen.appendChild(content);

  return screen;
}

// ============================================================
// LEVEL INTRO
// ============================================================
function renderLevelIntro() {
  const level = getLevel();
  if (!level) { setState({screen:'start'}); return renderStart(); }

  const screen = el('div', {className:'screen', style:{alignItems:'center', justifyContent:'center', overflow:'hidden'}});

  const canvas = document.createElement('canvas');
  canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;z-index:0;';
  screen.appendChild(canvas);

  function drawDeepScene() {
    const W = canvas.width = canvas.offsetWidth || window.innerWidth;
    const H = canvas.height = canvas.offsetHeight || window.innerHeight;
    const ctx = canvas.getContext('2d');
    const [bg1, bg2] = level.bgGradient;

    const bgGrad = ctx.createLinearGradient(0,0,0,H);
    bgGrad.addColorStop(0, bg1);
    bgGrad.addColorStop(1, bg2);
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0,0,W,H);

    for (let i = 0; i < 3; i++) {
      const hGrad = ctx.createRadialGradient(W/2, H*(0.3+i*0.3), 0, W/2, H*(0.3+i*0.3), W*0.6);
      hGrad.addColorStop(0, `rgba(0,0,0,0)`);
      hGrad.addColorStop(1, `rgba(0,0,0,${0.15 + level.waterOpacity * 0.2})`);
      ctx.fillStyle = hGrad;
      ctx.fillRect(0,0,W,H);
    }

    function hexRGB(h) {
      if (!h || h[0] !== '#') return [0,0,0];
      const hex = h.length === 4 ? h[1]+h[1]+h[2]+h[2]+h[3]+h[3] : h.slice(1);
      return [parseInt(hex.slice(0,2),16)||0, parseInt(hex.slice(2,4),16)||0, parseInt(hex.slice(4,6),16)||0];
    }
    const [gr,gg,gb] = hexRGB(level.glowColor);

    for (let i = 0; i < 40 + level.id * 8; i++) {
      const px = Math.random() * W;
      const py = Math.random() * H;
      const pr = 0.5 + Math.random() * 2;
      const pa = 0.1 + Math.random() * 0.5;
      ctx.beginPath(); ctx.arc(px, py, pr, 0, Math.PI*2);
      ctx.fillStyle = `rgba(${gr},${gg},${gb},${pa})`;
      ctx.fill();
      if (Math.random() > 0.6) {
        const glow = ctx.createRadialGradient(px,py,0,px,py,pr*4);
        glow.addColorStop(0, `rgba(${gr},${gg},${gb},${pa*0.6})`);
        glow.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = glow;
        ctx.beginPath(); ctx.arc(px,py,pr*4,0,Math.PI*2); ctx.fill();
      }
    }

    ctx.save(); ctx.globalAlpha = 0.12 + level.id * 0.04;
    for (let s = 0; s < 3; s++) {
      const sx = s === 0 ? W*0.08 : s === 1 ? W*0.92 : W*0.5;
      ctx.strokeStyle = level.glowColor;
      ctx.lineWidth = 2 + level.id;
      ctx.beginPath();
      ctx.moveTo(sx, 0);
      for (let y = 0; y < H; y += 30) {
        ctx.lineTo(sx + Math.sin(y/60 + s) * (15 + level.id*3), y);
      }
      ctx.stroke();
    }
    ctx.restore();

    ctx.save();
    ctx.font = `${18 + level.id * 2}px serif`;
    level.creatures.forEach((c, i) => {
      const cx2 = c.x * W;
      const cy2 = c.y * H;
      const alpha = 0.3 + (i%3)*0.2;
      ctx.globalAlpha = alpha;
      ctx.fillText(c.emoji, cx2, cy2);
    });
    ctx.restore();
  }

  setTimeout(() => {
    drawDeepScene();
    window.addEventListener('resize', drawDeepScene);
    registerCleanup(() => window.removeEventListener('resize', drawDeepScene));
  }, 10);

  screen.appendChild(el('div', {className:'overlay', style:{background:`rgba(0,0,0,${0.35 + level.id*0.05})`, zIndex:1}}));
  screen.appendChild(el('div', {className:'overlay', style:{
    background:'radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,0.5) 100%)',
    zIndex:2
  }}));

  const content = el('div', {className:'content', style:{
    display:'flex', flexDirection:'column', alignItems:'center', gap:'1.5rem',
    padding:'2rem', textAlign:'center', maxWidth:'540px',
    animation:'fade-in-up 0.8s ease forwards', zIndex:10
  }});

  const badge = el('div', {style:{
    display:'inline-flex', alignItems:'center', gap:'8px',
    borderRadius:'99px', border:`1px solid ${level.glowColor}50`,
    backgroundColor:`${level.glowColor}12`,
    color:level.glowColor, padding:'0.4rem 1.25rem',
    fontSize:'0.8rem', fontFamily:'var(--font-mono)'
  }}, `▼ ${level.depthStart.toLocaleString()}m – ${level.depthEnd.toLocaleString()}m`);

  const levelLabel = el('p', {style:{
    fontSize:'0.65rem', letterSpacing:'0.3em', textTransform:'uppercase',
    color:level.glowColor, fontWeight:'700', fontFamily:'var(--font-mono)'
  }}, `ZONE ${level.id} OF 4`);

  const levelName = el('h2', {style:{
    fontFamily:'var(--font-display)',
    fontSize:'clamp(2rem,6vw,3.2rem)',
    fontWeight:'900', color:'#fff', lineHeight:'1.1',
    textShadow:`0 0 40px ${level.glowColor}50, 0 2px 20px rgba(0,0,0,0.8)`
  }}, level.name);

  const levelSub = el('p', {style:{
    fontFamily:'var(--font-body)', fontStyle:'italic',
    fontSize:'1.05rem', color:'rgba(255,255,255,0.5)'
  }}, level.subtitle);

  const desc = el('p', {style:{
    fontFamily:'var(--font-body)', fontSize:'1rem', lineHeight:'1.75',
    color:'rgba(255,255,255,0.78)', maxWidth:'460px',
    textShadow:'0 1px 8px rgba(0,0,0,0.9)'
  }}, level.description);

  const calamityBox = el('div', {style:{
    background:`rgba(0,0,0,0.5)`, border:`1px solid ${level.glowColor}30`,
    borderRadius:'0.75rem', padding:'0.75rem 1.25rem',
    display:'flex', gap:'8px', alignItems:'flex-start', backdropFilter:'blur(8px)'
  }});
  calamityBox.appendChild(el('span', {style:{color:level.glowColor,fontSize:'1rem'}}, '⚠'));
  const calamityText = el('div', {});
  calamityText.appendChild(el('p', {style:{fontSize:'0.7rem',letterSpacing:'0.15em',textTransform:'uppercase',color:level.glowColor,fontFamily:'var(--font-mono)'}}, `Calamity: ${level.calamityName}`));
  calamityText.appendChild(el('p', {style:{fontSize:'0.875rem',color:'rgba(255,255,255,0.6)',marginTop:'2px'}}, level.calamityDesc));
  calamityBox.appendChild(calamityText);

  const challengeInfo = el('div', {style:{display:'flex',gap:'1.5rem',fontSize:'0.875rem',color:'rgba(255,255,255,0.45)',fontFamily:'var(--font-mono)'}});
  challengeInfo.innerHTML = `<span><strong style="color:${level.glowColor}">${level.challenges.length}</strong> challenges</span><span style="color:rgba(255,255,255,0.2)">|</span><span><strong style="color:#f59e0b">4:00</strong> per challenge</span>`;

  const btn = el('button', {
    className:'btn-primary',
    style:{
      borderColor:`${level.glowColor}60`, backgroundColor:`${level.glowColor}18`,
      fontFamily:'var(--font-display)', letterSpacing:'0.1em'
    },
    onClick() { setState({screen:'challenge'}); }
  }, 'Engage Calamity');
  btn.appendChild(el('div', {className:'shimmer'}));
  btn.addEventListener('mouseenter', () => { btn.style.backgroundColor=`${level.glowColor}35`; btn.style.boxShadow=`0 0 40px ${level.glowColor}35`; });
  btn.addEventListener('mouseleave', () => { btn.style.backgroundColor=`${level.glowColor}18`; btn.style.boxShadow=''; });

  content.append(badge, levelLabel, levelName, levelSub, desc, calamityBox, challengeInfo, btn);
  screen.appendChild(content);
  return screen;
}

