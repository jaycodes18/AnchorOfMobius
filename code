function renderStart() {
  const screen = el('div', {className:'screen', style:{alignItems:'center', justifyContent:'flex-end', minHeight:'100vh', overflow:'hidden'}});

  const canvas = document.createElement('canvas');
  canvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;z-index:0;';
  screen.appendChild(canvas);

  function drawStartCanvas() {
    const W = canvas.width = canvas.offsetWidth || window.innerWidth;
    const H = canvas.height = canvas.offsetHeight || window.innerHeight;
    const ctx = canvas.getContext('2d');

    const sky = ctx.createLinearGradient(0, 0, 0, H * 0.56);
    sky.addColorStop(0, '#4fc3f7');
    sky.addColorStop(0.25, '#81d4fa');
    sky.addColorStop(0.55, '#b3e5fc');
    sky.addColorStop(0.8, '#e1f5fe');
    sky.addColorStop(1, '#fff9c4');
    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, W, H * 0.56);

    const horiz = ctx.createRadialGradient(W*0.75, H*0.5, 0, W*0.75, H*0.5, W*0.6);
    horiz.addColorStop(0, 'rgba(255,236,153,0.22)');
    horiz.addColorStop(1, 'rgba(255,236,153,0)');
    ctx.fillStyle = horiz; ctx.fillRect(0,0,W,H*0.56);

    const sunX = W * 0.75, sunY = H * 0.13;
    const sunHaze = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, 250);
    sunHaze.addColorStop(0, 'rgba(255,248,180,0.35)');
    sunHaze.addColorStop(0.4, 'rgba(255,220,80,0.12)');
    sunHaze.addColorStop(1, 'rgba(255,200,60,0)');
    ctx.fillStyle = sunHaze; ctx.fillRect(sunX-260, sunY-260, 520, 520);
    ctx.save(); ctx.globalAlpha = 0.18;
    ctx.strokeStyle = '#ffe44e'; ctx.lineWidth = 2;
    for(let r=0;r<12;r++){
      const ang = (r/12)*Math.PI*2;
      ctx.beginPath();
      ctx.moveTo(sunX+Math.cos(ang)*52, sunY+Math.sin(ang)*52);
      ctx.lineTo(sunX+Math.cos(ang)*110, sunY+Math.sin(ang)*110);
      ctx.stroke();
    }
    ctx.restore();
    const sunGlow = ctx.createRadialGradient(sunX, sunY, 0, sunX, sunY, 55);
    sunGlow.addColorStop(0, '#fffde0');
    sunGlow.addColorStop(0.4, '#ffe566');
    sunGlow.addColorStop(1, 'rgba(255,220,80,0)');
    ctx.fillStyle = sunGlow; ctx.fillRect(sunX-60, sunY-60, 120, 120);
    ctx.beginPath(); ctx.arc(sunX, sunY, 42, 0, Math.PI*2);
    ctx.fillStyle = '#fffde0'; ctx.fill();

    function drawCloud(x, y, s) {
      ctx.save(); ctx.globalAlpha = 0.88;
      ctx.fillStyle = '#ffffff';
      [[0,0,s*1.2],[s*0.8,-s*0.4,s*0.9],[s*1.6,-s*0.2,s],[s*2.4,0,s*0.8]].forEach(([dx,dy,r])=>{
        ctx.beginPath(); ctx.arc(x+dx, y+dy, r, 0, Math.PI*2); ctx.fill();
      });
      ctx.restore();
    }
    drawCloud(W*0.05, H*0.08, 28);
    drawCloud(W*0.28, H*0.05, 22);
    drawCloud(W*0.5, H*0.1, 20);
    drawCloud(W*0.88, H*0.2, 24);

    const ocean = ctx.createLinearGradient(0, H*0.5, 0, H);
    ocean.addColorStop(0, '#0d6ea8');
    ocean.addColorStop(0.15, '#0a4d7e');
    ocean.addColorStop(0.35, '#072e52');
    ocean.addColorStop(0.6, '#041829');
    ocean.addColorStop(1, '#020c14');
    ctx.fillStyle = ocean;
    ctx.fillRect(0, H * 0.5, W, H * 0.5);

    ctx.save(); ctx.globalAlpha = 0.18;
    for (let i = 0; i < 10; i++) {
      const wy = H * 0.51 + i * H * 0.018;
      const t = Date.now() / 1800 + i * 0.4;
      ctx.beginPath(); ctx.moveTo(0, wy);
      for (let x = 0; x <= W; x += 15) {
        ctx.lineTo(x, wy + Math.sin(x/50 + t) * 3.5);
      }
      ctx.strokeStyle = i < 3 ? '#93c5fd' : '#7dd3fc'; ctx.lineWidth = 1.5; ctx.stroke();
    }
    ctx.restore();

    ctx.save(); ctx.globalAlpha = 0.5;
    for (let s = 0; s < 18; s++) {
      const sx = (s * W / 18 + (Date.now()/1200)*(s%3===0?1:-1)) % W;
      const sy = H*0.505 + (s%4)*H*0.008;
      ctx.fillStyle = '#fff';
      ctx.beginPath(); ctx.arc(sx, sy, 1.5, 0, Math.PI*2); ctx.fill();
    }
    ctx.restore();

    const islandX = W / 2;
    const islandY = H * 0.485;
    const islandW = Math.min(320, W * 0.5);
    const islandH = islandW * 0.38;

    const rootDefs = [
      { tx: -0.38, ex: -0.55, cp1ox: -35, cp1oy: 0.3, cp2ox: 20, glow: 0.7, thick: 9 },
      { tx: -0.22, ex: -0.3,  cp1ox:  10, cp1oy: 0.38, cp2ox: -15, glow: 0.35, thick: 6 },
      { tx: -0.06, ex: -0.08, cp1ox: -20, cp1oy: 0.42, cp2ox:  10, glow: 0.5, thick: 8 },
      { tx:  0.10, ex:  0.12, cp1ox:  25, cp1oy: 0.35, cp2ox: -20, glow: 0.3, thick: 5 },
      { tx:  0.22, ex:  0.28, cp1ox: -10, cp1oy: 0.4,  cp2ox:  15, glow: 0.65, thick: 10 },
      { tx:  0.36, ex:  0.5,  cp1ox:  30, cp1oy: 0.32, cp2ox: -10, glow: 0.4, thick: 7 },
    ];
    const rootStartY = islandY + islandH * 0.18;

    rootDefs.forEach(rd => {
      const sx = islandX + islandW * rd.tx;
      const ex = islandX + islandW * rd.ex;
      const cp1x = sx + rd.cp1ox;
      const cp1y = rootStartY + (H - rootStartY) * rd.cp1oy;
      const cp2x = ex + rd.cp2ox;
      const cp2y = H - (H - rootStartY) * 0.15;

      ctx.save();
      ctx.strokeStyle = `rgba(6,182,212,${rd.glow * 0.5})`;
      ctx.lineWidth = rd.thick + 10;
      ctx.shadowColor = '#06b6d4'; ctx.shadowBlur = 20;
      ctx.beginPath(); ctx.moveTo(sx, rootStartY);
      ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, ex, H + 10);
      ctx.stroke(); ctx.restore();

      const rg = ctx.createLinearGradient(sx, rootStartY, ex, H);
      rg.addColorStop(0, '#6d4c41');
      rg.addColorStop(0.25, '#4e342e');
      rg.addColorStop(0.6, '#3e2723');
      rg.addColorStop(1, 'rgba(10,5,2,0.4)');
      ctx.strokeStyle = rg; ctx.lineWidth = rd.thick; ctx.lineCap = 'round';
      ctx.beginPath(); ctx.moveTo(sx, rootStartY);
      ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, ex, H + 10);
      ctx.stroke();

      ctx.save(); ctx.globalAlpha = 0.4 + rd.glow * 0.35;
      ctx.strokeStyle = '#22d3ee'; ctx.lineWidth = 1.2; ctx.setLineDash([5, 9]);
      ctx.beginPath(); ctx.moveTo(sx, rootStartY);
      ctx.bezierCurveTo(cp1x+2, cp1y+3, cp2x-2, cp2y-3, ex, H + 10);
      ctx.stroke(); ctx.setLineDash([]); ctx.restore();
    });

    const cliffGrad = ctx.createLinearGradient(islandX, islandY - islandH*0.1, islandX, islandY + islandH*0.5);
    cliffGrad.addColorStop(0, '#795548');
    cliffGrad.addColorStop(0.4, '#6d4c41');
    cliffGrad.addColorStop(1, '#4e342e');
    ctx.fillStyle = cliffGrad;
    ctx.beginPath();
    ctx.moveTo(islandX - islandW*0.52, islandY - islandH*0.05);
    ctx.bezierCurveTo(islandX - islandW*0.58, islandY + islandH*0.3, islandX - islandW*0.45, islandY + islandH*0.5, islandX - islandW*0.2, islandY + islandH*0.45);
    ctx.bezierCurveTo(islandX, islandY + islandH*0.55, islandX + islandW*0.2, islandY + islandH*0.45, islandX + islandW*0.45, islandY + islandH*0.5);
    ctx.bezierCurveTo(islandX + islandW*0.58, islandY + islandH*0.3, islandX + islandW*0.52, islandY - islandH*0.05, islandX + islandW*0.52, islandY - islandH*0.05);
    ctx.closePath(); ctx.fill();

    const islandGrad = ctx.createLinearGradient(islandX, islandY - islandH, islandX, islandY + islandH*0.05);
    islandGrad.addColorStop(0, '#66bb6a');
    islandGrad.addColorStop(0.25, '#4caf50');
    islandGrad.addColorStop(0.55, '#388e3c');
    islandGrad.addColorStop(0.8, '#8d6e63');
    islandGrad.addColorStop(1, '#795548');
    ctx.fillStyle = islandGrad;
    ctx.beginPath();
    ctx.moveTo(islandX - islandW*0.52, islandY - islandH*0.05);
    ctx.bezierCurveTo(islandX - islandW*0.58, islandY - islandH*0.2, islandX - islandW*0.38, islandY - islandH, islandX, islandY - islandH);
    ctx.bezierCurveTo(islandX + islandW*0.38, islandY - islandH, islandX + islandW*0.58, islandY - islandH*0.2, islandX + islandW*0.52, islandY - islandH*0.05);
    ctx.bezierCurveTo(islandX + islandW*0.55, islandY + islandH*0.1, islandX - islandW*0.55, islandY + islandH*0.1, islandX - islandW*0.52, islandY - islandH*0.05);
    ctx.closePath(); ctx.fill();

    ctx.save(); ctx.globalAlpha = 0.55;
    ctx.fillStyle = '#81c784';
    ctx.beginPath();
    ctx.ellipse(islandX, islandY - islandH*0.85, islandW*0.42, islandH*0.22, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();

    function drawTree(tx, ty, sz) {
      ctx.fillStyle = '#5d4037';
      ctx.fillRect(tx - sz*0.12, ty, sz*0.24, sz*0.65);
      ctx.fillStyle = '#1b5e20';
      ctx.beginPath(); ctx.arc(tx, ty - sz*0.05, sz*0.55, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#2e7d32';
      ctx.beginPath(); ctx.arc(tx - sz*0.2, ty + sz*0.05, sz*0.4, 0, Math.PI*2); ctx.fill();
      ctx.beginPath(); ctx.arc(tx + sz*0.22, ty + sz*0.08, sz*0.38, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = '#43a047';
      ctx.beginPath(); ctx.arc(tx, ty - sz*0.15, sz*0.32, 0, Math.PI*2); ctx.fill();
    }
    drawTree(islandX - islandW*0.22, islandY - islandH*1.02, 24);
    drawTree(islandX + islandW*0.12, islandY - islandH*1.1, 28);
    drawTree(islandX - islandW*0.04, islandY - islandH*0.9, 20);
    drawTree(islandX + islandW*0.3, islandY - islandH*0.88, 17);

    ctx.save(); ctx.globalAlpha = 0.8;
    [[islandX-islandW*0.1, islandY-islandH*0.78,'#ffcc02'],
     [islandX+islandW*0.22, islandY-islandH*0.72,'#ff5252'],
     [islandX-islandW*0.3, islandY-islandH*0.68,'#ff80ab']].forEach(([fx,fy,fc])=>{
      ctx.fillStyle = fc;
      ctx.beginPath(); ctx.arc(fx, fy, 3.5, 0, Math.PI*2); ctx.fill();
    });
    ctx.restore();

    ctx.save(); ctx.globalAlpha = 0.22;
    const foamGrad = ctx.createRadialGradient(islandX, islandY+2, 0, islandX, islandY+2, islandW*0.62);
    foamGrad.addColorStop(0.7, '#b3e5fc'); foamGrad.addColorStop(1, 'rgba(179,229,252,0)');
    ctx.fillStyle = foamGrad;
    ctx.beginPath(); ctx.ellipse(islandX, islandY+2, islandW*0.6, islandH*0.2, 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();

    ctx.save();
    ctx.font = `13px 'Share Tech Mono', monospace`;
    ctx.fillStyle = 'rgba(255,255,255,0.3)';
    ctx.fillText('▼ 4,000m of unknown depth below', W/2 - 130, H * 0.98);
    ctx.restore();
  }

  setTimeout(() => {
    drawStartCanvas();
    window.addEventListener('resize', drawStartCanvas);
    registerCleanup(() => window.removeEventListener('resize', drawStartCanvas));
  }, 10);

