// ============================================================
// REVELATION SCREEN — FIX: skip button to jump to choices
// ============================================================
function renderRevelation() {
  const screen = el('div', {className:'screen', style:{background:'#060000', minHeight:'100vh'}});

  const bgCanvas = document.createElement('canvas');
  bgCanvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;';
  screen.appendChild(bgCanvas);

  let revRafId = null;
  function drawRevBg(ts) {
    const W=bgCanvas.width=bgCanvas.offsetWidth||window.innerWidth;
    const H=bgCanvas.height=bgCanvas.offsetHeight||window.innerHeight;
    const ctx=bgCanvas.getContext('2d');
    ctx.clearRect(0,0,W,H);

    const pulse=0.5+0.5*Math.sin(ts/2000);
    const bg=ctx.createRadialGradient(W/2,H,0,W/2,H,H*1.2);
    bg.addColorStop(0,`rgba(120,0,0,${0.08+pulse*0.05})`);
    bg.addColorStop(0.5,`rgba(60,0,0,${0.04+pulse*0.02})`);
    bg.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);

    ctx.save(); ctx.globalAlpha=0.06+pulse*0.03;
    ctx.strokeStyle='#ef4444'; ctx.lineWidth=2;
    for(let t2=0;t2<3;t2++){
      const tx2=t2===0?W*0.05:t2===1?W*0.95:W*0.5;
      ctx.beginPath(); ctx.moveTo(tx2,H);
      for(let y=H;y>=0;y-=15){
        ctx.lineTo(tx2+Math.sin(y/100+ts/3000+t2*2)*(25+t2*10),y);
      }
      ctx.stroke();
    }
    ctx.restore();
    revRafId = requestAnimationFrame(drawRevBg);
  }
  revRafId = requestAnimationFrame(drawRevBg);
  registerCleanup(() => { if(revRafId) cancelAnimationFrame(revRafId); });

  screen.appendChild(el('div',{className:'overlay',style:{background:'radial-gradient(ellipse at center, transparent 20%, rgba(0,0,0,0.6) 70%, black 100%)',zIndex:1,pointerEvents:'none'}}));

  // FIX: skip button — jumps straight to choice section
  let revTimeouts = [];
  const skipBtn = el('button', {className:'btn-skip', onClick() {
    // Clear all pending timeouts
    revTimeouts.forEach(t => clearTimeout(t));
    revTimeouts = [];
    // Reveal all text immediately
    textEls.forEach(p => { p.style.opacity='1'; p.style.transform='translateY(0)'; });
    choiceSection.style.opacity='1';
    setTimeout(() => {
      choiceSection.scrollIntoView({behavior:'smooth',block:'center'});
    }, 100);
    skipBtn.remove();
  }}, 'Skip to Choice ▶▶');
  screen.appendChild(skipBtn);

  const content = el('div', {className:'content', style:{
    display:'flex',flexDirection:'column',alignItems:'center',gap:'2rem',
    padding:'5rem 1.5rem 4rem', textAlign:'center', minHeight:'100vh', zIndex:10
  }});

  content.appendChild(el('div',{style:{
    fontFamily:'var(--font-mono)',fontSize:'0.7rem',letterSpacing:'0.35em',
    textTransform:'uppercase',color:'rgba(239,68,68,0.5)',
    border:'1px solid rgba(239,68,68,0.2)',borderRadius:'99px',
    padding:'0.4rem 1.25rem',backgroundColor:'rgba(239,68,68,0.06)'
  }},'8,000 METERS — THE BOTTOM'));

  const textWrap = el('div', {style:{display:'flex',flexDirection:'column',alignItems:'center',gap:'1.75rem',maxWidth:'700px'}});
  const textEls = REVELATION_STAGES.map((stage,i)=>{
    let style={};
    if(i===0||i===1) style={fontFamily:'var(--font-mono)',fontSize:'0.9rem',letterSpacing:'0.35em',textTransform:'uppercase',color:'rgba(255,255,255,0.35)',opacity:'0',transform:'translateY(12px)',transition:'all 1s ease'};
    else if(i===4||i===7||i===8) style={fontFamily:'var(--font-display)',fontSize:'clamp(1.6rem,4vw,2.4rem)',fontWeight:'700',color:'#f87171',lineHeight:'1.2',textShadow:'0 0 50px rgba(239,68,68,0.4)',opacity:'0',transform:'translateY(12px)',transition:'all 1.2s ease'};
    else if(i===9) style={fontFamily:'var(--font-body)',fontStyle:'italic',fontSize:'1.1rem',color:'rgba(255,255,255,0.5)',opacity:'0',transform:'translateY(12px)',transition:'all 1s ease'};
    else style={fontFamily:'var(--font-body)',fontSize:'1.1rem',lineHeight:'1.8',color:'rgba(255,255,255,0.72)',maxWidth:'620px',opacity:'0',transform:'translateY(12px)',transition:'all 1.1s ease'};
    const p=el('p',{style}, stage.text);
    textWrap.appendChild(p);
    return p;
  });
  content.appendChild(textWrap);

  const choiceSection = el('div', {style:{opacity:'0',transition:'opacity 1.5s ease',marginTop:'3rem',display:'flex',flexDirection:'column',alignItems:'center',gap:'2rem'}});

  const choiceTitle = el('p', {style:{fontFamily:'var(--font-mono)',fontSize:'0.7rem',letterSpacing:'0.3em',textTransform:'uppercase',color:'rgba(255,255,255,0.3)'}}, 'Choose your fate');

  const choiceRow = el('div', {style:{display:'flex',gap:'1.5rem',flexWrap:'wrap',justifyContent:'center'}});

  function makeChoiceBtn(choiceType, accent, icon, heading, subtext) {
    const btn = el('button', {className:'choice-btn', style:{borderColor:`${accent}30`,backgroundColor:`${accent}08`,color:'#fff',maxWidth:'280px'}});
    btn.innerHTML=`
      <div style="width:52px;height:52px;border-radius:50%;border:1px solid ${accent}40;background:${accent}18;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">${icon}</div>
      <h3 style="font-family:var(--font-display);font-size:1.2rem;font-weight:700;color:${accent};letter-spacing:0.05em;">${heading}</h3>
      <p style="font-family:var(--font-body);font-size:0.9rem;line-height:1.6;color:rgba(255,255,255,0.5);">${subtext}</p>`;
    btn.addEventListener('mouseenter',()=>{btn.style.borderColor=`${accent}60`;btn.style.backgroundColor=`${accent}18`;btn.style.boxShadow=`0 0 50px ${accent}20`;});
    btn.addEventListener('mouseleave',()=>{btn.style.borderColor=`${accent}30`;btn.style.backgroundColor=`${accent}08`;btn.style.boxShadow='';});
    btn.addEventListener('click',()=>showEnding(choiceType, endingSection));
    return btn;
  }

  const sacrificeBtn = makeChoiceBtn('sacrifice','#22d3ee','✦','Let Go','Put everything left into one burst. All the Nen, all of it. Seal it back into sleep. You won\'t make it back up. But everyone up there will wake up tomorrow and never know this happened.');
  const mergeBtn = makeChoiceBtn('merge','#ef4444','∞','Open the Hatch','Let it in. See what you become. Ten million years of memory is a lot to carry — but you won\'t be carrying it alone.');
  choiceRow.append(sacrificeBtn, mergeBtn);

  const endingSection = el('div', {style:{opacity:'0',transition:'opacity 2s ease',maxWidth:'640px',textAlign:'center',display:'flex',flexDirection:'column',alignItems:'center',gap:'1.5rem',marginTop:'1rem'}});
  choiceSection.append(choiceTitle, choiceRow, endingSection);
  content.appendChild(choiceSection);
  screen.appendChild(content);

  // Staggered reveal
  REVELATION_STAGES.forEach((stage,i)=>{
    const tId = setTimeout(()=>{
      textEls[i].style.opacity='1';
      textEls[i].style.transform='translateY(0)';
    }, stage.delay);
    revTimeouts.push(tId);
  });
  const choiceTimeout = setTimeout(()=>{
    choiceSection.style.opacity='1';
    skipBtn.remove();
    choiceSection.scrollIntoView({behavior:'smooth',block:'center'});
  }, 27000);
  revTimeouts.push(choiceTimeout);
  registerCleanup(() => revTimeouts.forEach(t => clearTimeout(t)));

  return screen;
}

function showEnding(choice, endingSection) {
  endingSection.innerHTML='';
  const accent = choice==='sacrifice'?'#22d3ee':'#fca5a5';
  const divider = el('div',{style:{height:'1px',width:'200px',background:`linear-gradient(to right,transparent,${accent},transparent)`,margin:'0 auto'}});

  let data;
  if(choice==='sacrifice'){
    data = {
      quote:'"I went down so they could stay up."',
      story:'You put everything into it. Every last bit of Nen — the reserves you\'d been rationing since zone two, the dregs you didn\'t think would matter. One pulse. The thing shudders. You feel it through the floor of the bathysphere, through your feet, through your teeth. Then it goes still. Not dead. Just — back under. Dreaming again. The instruments flicker back on. The hull holds. You don\'t.',
      epilogue:'They\'ll notice a tremor on the seismographs. A few researchers will write papers. The island stops sinking that afternoon and nobody can explain it.',
      quoteColor:'#22d3ee'
    };
  } else {
    data = {
      quote:'"It wasn\'t what I expected. Nothing that big ever is."',
      story:'The hatch opens. The water comes in and it\'s warm — warmer than it should be at four thousand meters — and it doesn\'t kill you. It just fills in the gaps. Suddenly you know what the carvings were for. You know who made them and why they stopped. You know there are eleven others like this one, scattered under eleven other islands, and they\'ve been waiting a long time for someone to knock. The bathysphere dissolves around you. You don\'t need it anymore.',
      epilogue:'The island moves. Not much — just enough that people notice. By morning the coastline has shifted. By evening nobody can agree on what the maps used to say.',
      quoteColor:'#fca5a5'
    };
  }

  const quoteEl = el('p',{style:{fontFamily:'var(--font-display)',fontSize:'clamp(1.1rem,3vw,1.5rem)',fontWeight:'700',color:data.quoteColor,lineHeight:'1.4',fontStyle:'italic'}},data.quote);
  const storyEl = el('p',{style:{fontFamily:'var(--font-body)',lineHeight:'1.8',color:'rgba(255,255,255,0.7)',fontSize:'1.05rem'}},data.story);
  const epilogueEl = el('p',{style:{fontSize:'0.9rem',color:`${data.quoteColor}80`,fontStyle:'italic',fontFamily:'var(--font-body)'}},data.epilogue);

  const playAgainBtn = el('button',{
    style:{marginTop:'1.5rem',borderRadius:'99px',border:'1px solid rgba(255,255,255,0.15)',backgroundColor:'rgba(255,255,255,0.04)',color:'rgba(255,255,255,0.7)',padding:'0.75rem 2.5rem',fontWeight:'600',cursor:'pointer',transition:'all 0.2s',fontFamily:'var(--font-display)',letterSpacing:'0.1em',fontSize:'0.9rem'},
    onClick(){setState({screen:'start',currentLevel:0,currentChallenge:0,completedLevels:[],failedAttempts:0,startTime:null,challengeKey:0,nenLevel:100,treasureClicks:0});}
  },'Play Again');
  playAgainBtn.addEventListener('mouseenter',()=>{playAgainBtn.style.backgroundColor='rgba(255,255,255,0.1)';playAgainBtn.style.boxShadow='0 0 30px rgba(255,255,255,0.08)';});
  playAgainBtn.addEventListener('mouseleave',()=>{playAgainBtn.style.backgroundColor='rgba(255,255,255,0.04)';playAgainBtn.style.boxShadow='';});

  endingSection.append(divider, quoteEl, storyEl, epilogueEl, playAgainBtn);
  setTimeout(()=>{
    endingSection.style.opacity='1';
    endingSection.scrollIntoView({behavior:'smooth',block:'center'});
  },800);
}

// ============================================================
// POLYFILL
// ============================================================
if(!CanvasRenderingContext2D.prototype.roundRect){
  CanvasRenderingContext2D.prototype.roundRect=function(x,y,w,h,r){
    if(Array.isArray(r)){const[r0,r1,r2,r3]=r.length>=4?r:r.length>=3?[r[0],r[1],r[2],r[1]]:r.length>=2?[r[0],r[1],r[0],r[1]]:[r[0],r[0],r[0],r[0]];
    this.beginPath();this.moveTo(x+r0,y);this.arcTo(x+w,y,x+w,y+h,r1);this.arcTo(x+w,y+h,x,y+h,r2);this.arcTo(x,y+h,x,y,r3);this.arcTo(x,y,x+w,y,r0);this.closePath();}
    else{if(w<2*r)r=w/2;if(h<2*r)r=h/2;this.beginPath();this.moveTo(x+r,y);this.arcTo(x+w,y,x+w,y+h,r);this.arcTo(x+w,y+h,x,y+h,r);this.arcTo(x,y+h,x,y,r);this.arcTo(x,y,x+w,y,r);this.closePath();}
    return this;
  };
}

